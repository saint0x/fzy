enum PointerOwner {
    Owned, Borrowed, Out, InOut,
}
enum PanicBoundary {
    Inherit, Abort, Error,
}
struct PointerContract {
    owner: PointerOwner, nullable: i32, mutable_mode: i32, panic_boundary: PanicBoundary,
}
enum PointerIssue {
    None, BorrowedCannotBeNullable, OutRequiresMutable, InOutRequiresMutable, OwnerRequiresAbortBoundary,
}
struct PointerAssessment {
    contract: PointerContract, issue: PointerIssue,
}
fn normalize_flag(value: i32) -> i32 {
    if value == 0 {
        return 0
    }
    return 1
}
fn panic_boundary_from_flag(value: i32) -> PanicBoundary {
    if value == 1 {
        return PanicBoundary::Abort
    }
    return PanicBoundary::Error
}
fn contract(owner: PointerOwner, nullable: i32, mutable_mode: i32, panic_abort: i32) -> PointerContract {
    return PointerContract {
        owner: owner, nullable: normalize_flag(nullable), mutable_mode: normalize_flag(mutable_mode), panic_boundary: panic_boundary_from_flag(panic_abort),
    }
}
fn owned_contract(nullable: i32, mutable_mode: i32, panic_abort: i32) -> PointerContract {
    return contract(PointerOwner::Owned, nullable, mutable_mode, panic_abort)
}
fn borrowed_contract(nullable: i32, mutable_mode: i32) -> PointerContract {
    return contract(PointerOwner::Borrowed, nullable, mutable_mode, 0)
}
fn out_contract(nullable: i32, panic_abort: i32) -> PointerContract {
    return contract(PointerOwner::Out, nullable, 1, panic_abort)
}
fn inout_contract(nullable: i32, panic_abort: i32) -> PointerContract {
    return contract(PointerOwner::InOut, nullable, 1, panic_abort)
}
fn owner_label(owner: PointerOwner) -> str {
    match owner {
        PointerOwner::Owned => return "owned", PointerOwner::Borrowed => return "borrowed", PointerOwner::Out => return "out", PointerOwner::InOut => return "inout", _ => return "borrowed",
    }
}
fn panic_boundary_label(boundary: PanicBoundary) -> str {
    match boundary {
        PanicBoundary::Abort => return "abort", PanicBoundary::Error => return "error", _ => return "inherit",
    }
}
fn requires_abort_boundary(value: PointerContract) -> i32 {
    if value.owner == PointerOwner::Owned {
        return 1
    }
    if value.owner == PointerOwner::Out {
        return 1
    }
    if value.owner == PointerOwner::InOut {
        return 1
    }
    return 0
}
fn assess_contract(value: PointerContract) -> PointerAssessment {
    let safe = contract(value.owner, value.nullable, value.mutable_mode, if value.panic_boundary == PanicBoundary::Abort {
        1
    } else {
        0
    }
    ,) let mut issue = PointerIssue::None if safe.owner == PointerOwner::Borrowed & & safe.nullable == 1 {
        issue = PointerIssue::BorrowedCannotBeNullable
    } else {
        if safe.owner == PointerOwner::Out & & safe.mutable_mode == 0 {
            issue = PointerIssue::OutRequiresMutable
        } else {
            if safe.owner == PointerOwner::InOut & & safe.mutable_mode == 0 {
                issue = PointerIssue::InOutRequiresMutable
            } else {
                if requires_abort_boundary(safe) == 1 & & safe.panic_boundary != PanicBoundary::Abort {
                    issue = PointerIssue::OwnerRequiresAbortBoundary
                }
            }
        }
    }
    return PointerAssessment {
        contract: safe, issue: issue,
    }
}
fn is_contract_strict(value: PointerContract) -> i32 {
    let assessment = assess_contract(value) if assessment.issue == PointerIssue::None {
        return 1
    }
    return 0
}
fn pointer_issue_name(issue: PointerIssue) -> str {
    match issue {
        PointerIssue::BorrowedCannotBeNullable => return "borrowed_cannot_be_nullable", PointerIssue::OutRequiresMutable => return "out_requires_mutable", PointerIssue::InOutRequiresMutable => return "inout_requires_mutable", PointerIssue::OwnerRequiresAbortBoundary => return "owner_requires_abort_boundary", _ => return "none",
    }
}
fn contract_error(value: PointerContract) -> result.Error {
    let assessment = assess_contract(value) if assessment.issue == PointerIssue::None {
        return result.clear()
    }
    let safe = assessment.contract let summary = str.concat("pointer contract invalid: ", pointer_issue_name(assessment.issue)) let context = str.concat("owner=", str.concat(owner_label(safe.owner), str.concat(" nullable=", str.concat(str.from_i32(safe.nullable), str.concat(" mutable=", str.concat(str.from_i32(safe.mutable_mode), str.concat(" panic=", panic_boundary_label(safe.panic_boundary)),),),),),),) return result.with_context(result.from_ffi_failure(summary), context)
}
