struct RetryPolicy {
    max_attempts: i32, initial_delay_ms: i32, max_delay_ms: i32, factor: i32,
}
fn default_policy() -> RetryPolicy {
    return RetryPolicy {
        max_attempts: 3, initial_delay_ms: 25, max_delay_ms: 500, factor: 2,
    }
}
fn sanitize_policy(policy: RetryPolicy) -> RetryPolicy {
    let mut max_attempts = policy.max_attempts let mut initial_delay_ms = policy.initial_delay_ms let mut max_delay_ms = policy.max_delay_ms let mut factor = policy.factor if max_attempts < 1 {
        max_attempts = 1
    }
    if initial_delay_ms < 1 {
        initial_delay_ms = 1
    }
    if max_delay_ms < initial_delay_ms {
        max_delay_ms = initial_delay_ms
    }
    if factor < 1 {
        factor = 1
    }
    return RetryPolicy {
        max_attempts: max_attempts, initial_delay_ms: initial_delay_ms, max_delay_ms: max_delay_ms, factor: factor,
    }
}
fn delay_for_attempt(attempt: i32, initial: i32, max_delay: i32, factor: i32) -> i32 {
    let safe = sanitize_policy(RetryPolicy {
        max_attempts: attempt, initial_delay_ms: initial, max_delay_ms: max_delay, factor: factor,
    }
    ,) let mut delay = safe.initial_delay_ms if attempt <= 1 {
        return delay
    }
    let mut i = 1 while i < attempt {
        delay = delay * safe.factor if delay > safe.max_delay_ms {
            delay = safe.max_delay_ms
        }
        i = i + 1
    }
    return delay
}
