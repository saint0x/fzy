struct AbiVersion {
    major: i32,
    minor: i32,
    patch: i32,
}

struct LayoutContract {
    size: i32,
    align: i32,
    pointer_width: i32,
    stable_ffi: i32,
}

enum LayoutIssue {
    None,
    AlignmentExceedsSize,
    PointerWidthTooSmall,
    SizeAlignmentMismatch,
}

struct LayoutAssessment {
    contract: LayoutContract,
    issue: LayoutIssue,
}

fn clamp_nonnegative(value: i32) -> i32 {
    if value < 0 {
        return 0
    }
    return value
}

fn normalize_flag(value: i32) -> i32 {
    if value == 0 {
        return 0
    }
    return 1
}

fn normalize_alignment(align: i32) -> i32 {
    if align <= 1 {
        return 1
    }
    if align <= 2 {
        return 2
    }
    if align <= 4 {
        return 4
    }
    if align <= 8 {
        return 8
    }
    if align <= 16 {
        return 16
    }
    return 32
}

fn normalize_pointer_width(bytes: i32) -> i32 {
    if bytes <= 4 {
        return 4
    }
    if bytes <= 8 {
        return 8
    }
    return 16
}

fn version(major: i32, minor: i32, patch: i32) -> AbiVersion {
    return AbiVersion {
        major: clamp_nonnegative(major),
        minor: clamp_nonnegative(minor),
        patch: clamp_nonnegative(patch),
    }
}

fn version_code(v: AbiVersion) -> i32 {
    let major = v.major % 1000
    let minor = v.minor % 1000
    let patch = v.patch % 1000
    return ((major * 1000000) + (minor * 1000) + patch)
}

fn layout_contract(size: i32, align: i32, pointer_width: i32, stable_ffi: i32) -> LayoutContract {
    return LayoutContract {
        size: clamp_nonnegative(size),
        align: normalize_alignment(align),
        pointer_width: normalize_pointer_width(pointer_width),
        stable_ffi: normalize_flag(stable_ffi),
    }
}

fn assess_layout(value: LayoutContract) -> LayoutAssessment {
    let safe = layout_contract(value.size, value.align, value.pointer_width, value.stable_ffi)
    let mut issue = LayoutIssue::None
    if safe.size != 0 && safe.align > safe.size {
        issue = LayoutIssue::AlignmentExceedsSize
    } else {
        if safe.pointer_width < safe.align {
            issue = LayoutIssue::PointerWidthTooSmall
        } else {
            if safe.size != 0 && (safe.size % safe.align) != 0 {
                issue = LayoutIssue::SizeAlignmentMismatch
            }
        }
    }
    return LayoutAssessment {
        contract: safe,
        issue: issue,
    }
}

fn layout_is_valid(size: i32, align: i32, pointer_width: i32) -> i32 {
    let assessment = assess_layout(layout_contract(size, align, pointer_width, 0))
    if assessment.issue == LayoutIssue::None {
        return 1
    }
    return 0
}

fn layout_issue_name(issue: LayoutIssue) -> str {
    match issue {
        LayoutIssue::AlignmentExceedsSize => return "alignment_exceeds_size",
        LayoutIssue::PointerWidthTooSmall => return "pointer_width_too_small",
        LayoutIssue::SizeAlignmentMismatch => return "size_alignment_mismatch",
        _ => return "none",
    }
}

fn layout_error(value: LayoutContract) -> result.Error {
    let assessment = assess_layout(value)
    if assessment.issue == LayoutIssue::None {
        return result.clear()
    }
    let safe = assessment.contract
    let summary = str.concat("layout contract invalid: ", layout_issue_name(assessment.issue))
    let context = str.concat(
        "size=",
        str.concat(
            str.from_i32(safe.size),
            str.concat(
                " align=",
                str.concat(
                    str.from_i32(safe.align),
                    str.concat(
                        " ptr=",
                        str.concat(
                            str.from_i32(safe.pointer_width),
                            str.concat(" stable=", str.from_i32(safe.stable_ffi)),
                        ),
                    ),
                ),
            ),
        ),
    )
    return result.with_context(result.from_ffi_failure(summary), context)
}
