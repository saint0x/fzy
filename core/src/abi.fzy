struct Pair {
    left: i32,
    right: i32,
}

struct AbiVersion {
    major: i32,
    minor: i32,
    patch: i32,
}

fn normalize_component(value: i32) -> i32 {
    let modulo = value % 251
    if modulo < 0 {
        return modulo + 251
    }
    return modulo
}

fn clamp_nonnegative(value: i32) -> i32 {
    if value < 0 {
        return 0
    }
    return value
}

fn normalize_alignment(align: i32) -> i32 {
    if align <= 1 {
        return 1
    }
    if align <= 2 {
        return 2
    }
    if align <= 4 {
        return 4
    }
    if align <= 8 {
        return 8
    }
    if align <= 16 {
        return 16
    }
    return 32
}

fn normalize_pointer_width(bytes: i32) -> i32 {
    if bytes <= 4 {
        return 4
    }
    if bytes <= 8 {
        return 8
    }
    return 16
}

fn version(major: i32, minor: i32, patch: i32) -> AbiVersion {
    return AbiVersion {
        major: clamp_nonnegative(major),
        minor: clamp_nonnegative(minor),
        patch: clamp_nonnegative(patch),
    }
}

fn version_code(v: AbiVersion) -> i32 {
    let major = v.major % 1000
    let minor = v.minor % 1000
    let patch = v.patch % 1000
    return ((major * 1000000) + (minor * 1000) + patch)
}

fn layout_is_valid(size: i32, align: i32, pointer_width: i32) -> i32 {
    let safe_size = clamp_nonnegative(size)
    let safe_align = normalize_alignment(align)
    let safe_width = normalize_pointer_width(pointer_width)
    if safe_size == 0 {
        return 1
    }
    if safe_align > safe_size {
        return 0
    }
    if safe_width < safe_align {
        return 0
    }
    if (safe_size % safe_align) != 0 {
        return 0
    }
    return 1
}

fn layout_score(size: i32, align: i32, pointer_width: i32, stable_ffi: i32) -> i32 {
    let safe_size = clamp_nonnegative(size)
    let safe_align = normalize_alignment(align)
    let safe_width = normalize_pointer_width(pointer_width)
    let mut score = normalize_component(safe_size + (safe_align * 7) + (safe_width * 11))
    if layout_is_valid(safe_size, safe_align, safe_width) == 1 {
        score = normalize_component(score + 61)
    }
    if stable_ffi == 1 {
        score = normalize_component(score + 97)
    }
    return score
}

fn combine(left: i32, right: i32) -> i32 {
    let pair = Pair {
        left: normalize_component(left),
        right: normalize_component(right),
    }
    return normalize_component((pair.left * 3) + (pair.right * 5))
}

fn sample() -> i32 {
    let abi = version(1, 2, 3)
    let packed = version_code(abi)
    let layout = layout_score(32, 8, 8, 1)
    let pair_score = combine(11, 17)
    return normalize_component(pair_score + layout + (packed % 251))
}
