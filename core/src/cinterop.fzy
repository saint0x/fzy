struct PointerContract {
    owner: str,
    nullable: i32,
    mutable_mode: i32,
    panic_abort: i32,
}

fn normalize_flag(value: i32) -> i32 {
    if value == 0 {
        return 0
    }
    return 1
}

fn normalize_owner(owner: str) -> str {
    let normalized = str.lower_ascii(str.trim(owner))
    if normalized == "owned" {
        return "owned"
    }
    if normalized == "borrowed" {
        return "borrowed"
    }
    if normalized == "out" {
        return "out"
    }
    if normalized == "inout" {
        return "inout"
    }
    return "borrowed"
}

fn owner_score(owner: str) -> i32 {
    if owner == "owned" then return 11
    if owner == "borrowed" then return 7
    if owner == "out" then return 13
    if owner == "inout" then return 19
    return 17
}

fn contract(owner: str, nullable: i32, mutable_mode: i32, panic_abort: i32) -> PointerContract {
    return PointerContract {
        owner: normalize_owner(owner),
        nullable: normalize_flag(nullable),
        mutable_mode: normalize_flag(mutable_mode),
        panic_abort: normalize_flag(panic_abort),
    }
}

fn requires_panic_abort(value: PointerContract) -> i32 {
    if value.owner == "owned" {
        return 1
    }
    if value.owner == "out" {
        return 1
    }
    if value.owner == "inout" {
        return 1
    }
    return 0
}

fn is_contract_strict(value: PointerContract) -> i32 {
    if requires_panic_abort(value) == 1 && value.panic_abort == 0 {
        return 0
    }
    if value.owner == "borrowed" && value.nullable == 1 {
        return 0
    }
    if value.owner == "out" && value.mutable_mode == 0 {
        return 0
    }
    if value.owner == "inout" && value.mutable_mode == 0 {
        return 0
    }
    return 1
}

fn risk_class(value: PointerContract) -> i32 {
    let mut score = owner_score(value.owner)
    if value.nullable == 1 { score = score + 5 } else { score = score + 17 }
    if value.mutable_mode == 1 { score = score + 23 } else { score = score + 7 }
    if requires_panic_abort(value) == 1 { score = score + 29 } else { score = score + 11 }
    if is_contract_strict(value) == 1 { score = score + 41 } else { score = score + 3 }
    return score
}

fn contract_score(owner: str, nullable: i32, mutable_mode: i32, panic_abort: i32) -> i32 {
    let value = contract(owner, nullable, mutable_mode, panic_abort)
    let mut score = risk_class(value)
    if value.owner == "owned" && value.panic_abort == 1 { score = score + 31 }
    if value.owner == "borrowed" && value.nullable == 0 { score = score + 37 }
    if value.owner == "inout" && value.mutable_mode == 1 { score = score + 41 }
    return score
}

fn sample() -> i32 {
    let strict = contract("owned", 0, 1, 1)
    let borrowed = contract(" borrowed ", 0, 0, 0)
    return (risk_class(strict) + contract_score("out", 0, 1, 1) + is_contract_strict(borrowed)) % 251
}
