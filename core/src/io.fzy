// core.io
// Public facade for higher-level filesystem workflows such as metadata, copy,
// remove, and directory staging. Hidden subsystems include `core.fs`,
// compiler-known `path.*` intrinsics, and native backend file semantics.
use core.fs;
struct FileMetadata {
    path: str, name: str, exists: i32, is_file: i32, is_dir: i32, is_symlink: i32, size: i32, modified_unix_secs: i32,
}
struct DirEntry {
    path: str, name: str, exists: i32, is_file: i32, is_dir: i32, is_symlink: i32, size: i32, modified_unix_secs: i32,
}
struct DirectoryListing {
    root: str, names: ListHandle,
}
struct WriteTextPlan {
    path: str, value: str,
}
struct CopyPlan {
    src: str, dst: str, recursive: i32,
}
struct RemovePlan {
    path: str, recursive: i32,
}
fn normalize_path(raw_path: str) -> str {
    return str.trim(raw_path)
}
fn read_text(file_path: str) -> str {
    let normalized = normalize_path(file_path) if normalized == "" {
        return ""
    }
    return fs.read_file(normalized)
}
fn write_text_plan(file_path: str, value: str) -> WriteTextPlan {
    return WriteTextPlan {
        path: normalize_path(file_path), value: value,
    }
}
fn apply_write_text(request: WriteTextPlan) -> i32 {
    if request.path == "" {
        return 1
    }
    return fs.atomic_write(request.path, request.value)
}
fn write_text(file_path: str, value: str) -> i32 {
    return apply_write_text(write_text_plan(file_path, value))
}
fn mkdir(dir_path: str) -> i32 {
    let normalized = normalize_path(dir_path) if normalized == "" {
        return 1
    }
    return fs.mkdir(normalized)
}
fn exists(file_path: str) -> i32 {
    let normalized = normalize_path(file_path) if normalized == "" {
        return 0
    }
    return fs.exists(normalized)
}
fn is_file(file_path: str) -> i32 {
    let normalized = normalize_path(file_path) if normalized == "" {
        return 0
    }
    return fs.is_file(normalized)
}
fn is_dir(dir_path: str) -> i32 {
    let normalized = normalize_path(dir_path) if normalized == "" {
        return 0
    }
    return fs.is_dir(normalized)
}
fn is_symlink(file_path: str) -> i32 {
    let normalized = normalize_path(file_path) if normalized == "" {
        return 0
    }
    return fs.is_symlink(normalized)
}
fn remove_file(file_path: str) -> i32 {
    let normalized = normalize_path(file_path) if normalized == "" {
        return 1
    }
    return fs.remove_file(normalized)
}
fn remove_plan(file_path: str, recursive: i32) -> RemovePlan {
    return RemovePlan {
        path: normalize_path(file_path), recursive: recursive,
    }
}
fn remove_target(request: RemovePlan) -> i32 {
    if request.path == "" {
        return 1
    }
    if request.recursive == 1 {
        return fs.remove(request.path)
    }
    return fs.remove_file(request.path)
}
fn remove(file_path: str) -> i32 {
    return remove_target(remove_plan(file_path, 1))
}
fn stat_size(file_path: str) -> i32 {
    let normalized = normalize_path(file_path) if normalized == "" {
        return - 1
    }
    return fs.stat_size(normalized)
}
fn stat_mtime(file_path: str) -> i32 {
    let normalized = normalize_path(file_path) if normalized == "" {
        return - 1
    }
    return fs.stat_mtime(normalized)
}
fn temp_file(prefix: str) -> str {
    return fs.temp_file(prefix)
}
fn list_dir(dir_path: str) -> ListHandle {
    let normalized = normalize_path(dir_path) if normalized == "" {
        return list.new()
    }
    return fs.listdir(normalized)
}
fn metadata(file_path: str) -> FileMetadata {
    let normalized = normalize_path(file_path) let name = path.basename(normalized) let found = exists(normalized) if found == 0 {
        return FileMetadata {
            path: normalized, name: name, exists: 0, is_file: 0, is_dir: 0, is_symlink: 0, size: - 1, modified_unix_secs: - 1,
        }
    }
    return FileMetadata {
        path: normalized, name: name, exists: 1, is_file: is_file(normalized), is_dir: is_dir(normalized), is_symlink: is_symlink(normalized), size: stat_size(normalized), modified_unix_secs: stat_mtime(normalized),
    }
}
fn copy_plan(src: str, dst: str, recursive: i32) -> CopyPlan {
    return CopyPlan {
        src: normalize_path(src), dst: normalize_path(dst), recursive: recursive,
    }
}
fn execute_copy(request: CopyPlan) -> i32 {
    if request.src == "" | | request.dst == "" {
        return 1
    }
    if request.src == request.dst {
        return 0
    }
    if request.recursive == 1 {
        return fs.copy_tree(request.src, request.dst)
    }
    return fs.copy_file(request.src, request.dst)
}
fn copy_file(src: str, dst: str) -> i32 {
    return execute_copy(copy_plan(src, dst, 0))
}
fn copy_tree(src: str, dst: str) -> i32 {
    return execute_copy(copy_plan(src, dst, 1))
}
fn stage_tree(src: str, dst: str) -> i32 {
    return copy_tree(src, dst)
}
fn list_dir_entries(dir_path: str) -> DirectoryListing {
    return DirectoryListing {
        root: normalize_path(dir_path), names: list_dir(dir_path),
    }
}
fn dir_len(entries: DirectoryListing) -> i32 {
    return list.len(entries.names)
}
fn dir_name(entries: DirectoryListing, index: i32) -> str {
    return list.get(entries.names, index)
}
fn dir_path(entries: DirectoryListing, index: i32) -> str {
    return path.join(entries.root, dir_name(entries, index))
}
fn dir_entry(entries: DirectoryListing, index: i32) -> DirEntry {
    let name = dir_name(entries, index) let full_path = path.join(entries.root, name) let meta = metadata(full_path) return DirEntry {
        path: full_path, name: name, exists: meta.exists, is_file: meta.is_file, is_dir: meta.is_dir, is_symlink: meta.is_symlink, size: meta.size, modified_unix_secs: meta.modified_unix_secs,
    }
}
