use core.fs;

struct FileMetadata {
    path: str,
    name: str,
    exists: i32,
    is_file: i32,
    is_dir: i32,
    is_symlink: i32,
    size: i32,
    modified_unix_secs: i32,
}

struct DirEntry {
    path: str,
    name: str,
    exists: i32,
    is_file: i32,
    is_dir: i32,
    is_symlink: i32,
    size: i32,
    modified_unix_secs: i32,
}

struct DirEntries {
    root: str,
    names: ListHandle,
}

fn read_text(file_path: str) -> str {
    return fs.read_file(file_path)
}

fn write_text(file_path: str, value: str) -> i32 {
    return fs.atomic_write(file_path, value)
}

fn mkdir(dir_path: str) -> i32 {
    return fs.mkdir(dir_path)
}

fn exists(file_path: str) -> i32 {
    return fs.exists(file_path)
}

fn is_file(file_path: str) -> i32 {
    return fs.is_file(file_path)
}

fn is_dir(dir_path: str) -> i32 {
    return fs.is_dir(dir_path)
}

fn is_symlink(file_path: str) -> i32 {
    return fs.is_symlink(file_path)
}

fn remove_file(file_path: str) -> i32 {
    return fs.remove_file(file_path)
}

fn remove(file_path: str) -> i32 {
    return fs.remove(file_path)
}

fn stat_size(file_path: str) -> i32 {
    return fs.stat_size(file_path)
}

fn stat_mtime(file_path: str) -> i32 {
    return fs.stat_mtime(file_path)
}

fn temp_file(prefix: str) -> str {
    return fs.temp_file(prefix)
}

fn list_dir(dir_path: str) -> ListHandle {
    return fs.listdir(dir_path)
}

fn metadata(file_path: str) -> FileMetadata {
    let name = path.basename(file_path)
    let found = exists(file_path)
    if found == 0 {
        return FileMetadata {
            path: file_path,
            name: name,
            exists: 0,
            is_file: 0,
            is_dir: 0,
            is_symlink: 0,
            size: -1,
            modified_unix_secs: -1,
        }
    }
    return FileMetadata {
        path: file_path,
        name: name,
        exists: 1,
        is_file: is_file(file_path),
        is_dir: is_dir(file_path),
        is_symlink: is_symlink(file_path),
        size: stat_size(file_path),
        modified_unix_secs: stat_mtime(file_path),
    }
}

fn copy_file(src: str, dst: str) -> i32 {
    return fs.copy_file(src, dst)
}

fn copy_tree(src: str, dst: str) -> i32 {
    return fs.copy_tree(src, dst)
}

fn stage_tree(src: str, dst: str) -> i32 {
    return copy_tree(src, dst)
}

fn list_dir_entries(dir_path: str) -> DirEntries {
    return DirEntries {
        root: dir_path,
        names: list_dir(dir_path),
    }
}

fn dir_len(entries: DirEntries) -> i32 {
    return list.len(entries.names)
}

fn dir_name(entries: DirEntries, index: i32) -> str {
    return list.get(entries.names, index)
}

fn dir_path(entries: DirEntries, index: i32) -> str {
    return path.join(entries.root, dir_name(entries, index))
}

fn dir_entry(entries: DirEntries, index: i32) -> DirEntry {
    let name = dir_name(entries, index)
    let full_path = path.join(entries.root, name)
    let meta = metadata(full_path)
    return DirEntry {
        path: full_path,
        name: name,
        exists: meta.exists,
        is_file: meta.is_file,
        is_dir: meta.is_dir,
        is_symlink: meta.is_symlink,
        size: meta.size,
        modified_unix_secs: meta.modified_unix_secs,
    }
}

fn sample() -> i32 {
    let probe = temp_file("coreio")
    let root = path.dirname(probe)
    let entries = list_dir_entries(root)
    let mut score = dir_len(entries)
    score = score + metadata(probe).exists
    let copy = path.join(root, "coreio-sample-copy.txt")
    discard write_text(probe, "sample")
    score = score + copy_file(probe, copy)
    discard remove(copy)
    discard remove(probe)
    return score % 251
}
