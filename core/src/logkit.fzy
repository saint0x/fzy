use core.log;

enum LogLevel {
    Info,
    Warn,
    Error,
}

enum LogSink {
    Stdout,
    Stderr,
}

struct LogConfig {
    json: i32,
    include_correlation: i32,
    max_field_bytes: i32,
    sample_mod: i32,
    enabled: i32,
    sink: LogSink,
    min_level: LogLevel,
}

fn default_config() -> LogConfig {
    return LogConfig {
        json: 1,
        include_correlation: 1,
        max_field_bytes: 256,
        sample_mod: 1,
        enabled: 1,
        sink: LogSink::Stdout,
        min_level: LogLevel::Info,
    }
}

fn sanitize_config(config: LogConfig) -> LogConfig {
    let mut max_field_bytes = config.max_field_bytes
    let mut sample_mod = config.sample_mod
    let mut enabled = config.enabled
    let mut include_correlation = config.include_correlation
    let mut json_mode = config.json
    if max_field_bytes < 1 { max_field_bytes = 1 }
    if sample_mod < 1 { sample_mod = 1 }
    if enabled != 0 { enabled = 1 }
    if include_correlation != 0 { include_correlation = 1 }
    if json_mode != 0 { json_mode = 1 }
    return LogConfig {
        json: json_mode,
        include_correlation: include_correlation,
        max_field_bytes: max_field_bytes,
        sample_mod: sample_mod,
        enabled: enabled,
        sink: config.sink,
        min_level: config.min_level,
    }
}

fn level_name(level: LogLevel) -> str {
    match level {
        LogLevel::Warn => return "warn",
        LogLevel::Error => return "error",
        _ => return "info",
    }
}

fn sink_name(sink: LogSink) -> str {
    match sink {
        LogSink::Stderr => return "stderr",
        _ => return "stdout",
    }
}

fn set_json_mode(enabled: i32) -> i32 {
    return log.set_json(enabled)
}

fn set_logging_enabled(enabled: i32) -> i32 {
    return log.set_enabled(enabled)
}

fn set_level_name(level: str) -> i32 {
    return log.set_level(level)
}

fn set_min_level(level: LogLevel) -> i32 {
    return set_level_name(level_name(level))
}

fn set_sink_name(sink: str) -> i32 {
    return log.set_sink(sink)
}

fn set_output_sink(sink: LogSink) -> i32 {
    return set_sink_name(sink_name(sink))
}

fn use_stdout() -> i32 {
    return set_output_sink(LogSink::Stdout)
}

fn use_stderr() -> i32 {
    return set_output_sink(LogSink::Stderr)
}

fn quiet() -> i32 {
    return log.set_enabled(0)
}

fn verbose() -> i32 {
    return log.set_enabled(1)
}

fn set_policy(config: LogConfig) -> i32 {
    let safe = sanitize_config(config)
    let mut rc = 0
    rc = rc + set_logging_enabled(safe.enabled)
    rc = rc + set_json_mode(safe.json)
    rc = rc + set_output_sink(safe.sink)
    rc = rc + set_min_level(safe.min_level)
    return rc
}

fn clamp_field(value: str, max_bytes: i32) -> str {
    if max_bytes < 1 {
        return ""
    }
    if str.len(value) <= max_bytes {
        return value
    }
    return str.slice(value, 0, max_bytes)
}

fn should_sample(counter: i32, sample_mod: i32) -> i32 {
    if sample_mod <= 1 then return 1
    if counter < 0 then return 0
    if (counter % sample_mod) == 0 then return 1
    return 0
}

fn request_log_sampled(
    config: LogConfig,
    level: LogLevel,
    message: str,
    request_id: str,
    path: str,
    method: str,
    counter: i32
) -> i32 {
    let safe = sanitize_config(config)
    if safe.enabled == 0 {
        return 0
    }
    if should_sample(counter, safe.sample_mod) == 0 {
        return 0
    }
    let msg = clamp_field(message, safe.max_field_bytes)
    let rid = if safe.include_correlation == 1 {
        clamp_field(request_id, safe.max_field_bytes)
    } else {
        ""
    }
    let p = clamp_field(path, safe.max_field_bytes)
    let m = clamp_field(method, 16)
    let fields = map.new()
    if safe.include_correlation == 1 {
        discard map.set(fields, "request_id", json.str(rid))
    }
    discard map.set(fields, "path", json.str(p))
    discard map.set(fields, "method", json.str(m))
    discard map.set(fields, "level", json.str(level_name(level)))
    discard set_policy(safe)
    if level == LogLevel::Warn {
        discard log.warn(msg, log.fields(fields))
        return 2
    }
    if level == LogLevel::Error {
        discard log.error(msg, log.fields(fields))
        return 3
    }
    discard log.info(msg, log.fields(fields))
    return 1
}

fn request_log(config: LogConfig, level: LogLevel, message: str, request_id: str, path: str, method: str) -> i32 {
    return request_log_sampled(config, level, message, request_id, path, method, 0)
}

fn sample() -> i32 {
    let cfg = default_config()
    if should_sample(100, cfg.sample_mod) == 1 {
        let mut acc = request_log_sampled(cfg, LogLevel::Info, "core.log.sample", "rid-sample", "/health", "GET", 100)
        acc = acc + use_stdout()
        acc = acc + set_min_level(LogLevel::Warn)
        acc = acc + set_level_name("info")
        acc = acc + set_sink_name("stdout")
        acc = acc + set_logging_enabled(1)
        acc = acc + verbose()
        return acc % 251
    }
    return 0
}
