// core.network
// Public facade for transport/polling concepts that sit below `core.http`.
// Hidden subsystems include the native socket runtime, deterministic network
// replay machinery, and capability-enforced backend event routing.
enum SocketKind {
    Stream, Datagram, UnixDatagram,
}
enum PollSignal {
    Readable, Writable, Acceptable, Closed, Idle,
}
enum DeadlineState {
    Ready, Expired, Cancelled,
}
struct Endpoint {
    hostname: str, port: i32, tls: i32, ipv6: i32, kind: SocketKind,
}
struct SocketOptions {
    reuse_addr: i32, reuse_port: i32, tcp_nodelay: i32, keepalive: i32,
}
struct RequestContext {
    id: i32, request_id: str, deadline_ms: i32, has_deadline: i32, cancelled: i32,
}
fn parse_socket_kind(name: str) -> SocketKind {
    let normalized = str.lower_ascii(str.trim(name)) if normalized == "stream" then return SocketKind::Stream if normalized == "datagram" then return SocketKind::Datagram return SocketKind::UnixDatagram
}
fn socket_kind_name(kind: SocketKind) -> str {
    match kind {
        SocketKind::Stream => return "stream", SocketKind::Datagram => return "datagram", SocketKind::UnixDatagram => return "unix_datagram", _ => return "unix_datagram",
    }
}
fn default_socket_options() -> SocketOptions {
    return SocketOptions {
        reuse_addr: 1, reuse_port: 1, tcp_nodelay: 1, keepalive: 1,
    }
}
fn endpoint(hostname: str, port: i32, tls: i32, ipv6: i32, kind: SocketKind) -> Endpoint {
    let mut safe_port = port if safe_port < 0 {
        safe_port = 0
    }
    if safe_port > 65535 {
        safe_port = 65535
    }
    return Endpoint {
        hostname: str.trim(hostname), port: safe_port, tls: if tls == 0 {
            0
        } else {
            1
        }
        , ipv6: if ipv6 == 0 {
            0
        } else {
            1
        }
        , kind: kind,
    }
}
fn endpoint_is_secure(value: Endpoint) -> i32 {
    return value.tls
}
fn poll_signal(readable: i32, writable: i32, acceptable: i32, closed: i32) -> PollSignal {
    if closed == 1 then return PollSignal::Closed if readable == 1 then return PollSignal::Readable if writable == 1 then return PollSignal::Writable if acceptable == 1 then return PollSignal::Acceptable return PollSignal::Idle
}
fn request_context(id: i32, request_id: str) -> RequestContext {
    return RequestContext {
        id: id, request_id: request_id, deadline_ms: 0, has_deadline: 0, cancelled: 0,
    }
}
fn request_context_with_deadline(context: RequestContext, deadline_ms: i32) -> RequestContext {
    return RequestContext {
        id: context.id, request_id: context.request_id, deadline_ms: deadline_ms, has_deadline: 1, cancelled: context.cancelled,
    }
}
fn request_context_cancel(context: RequestContext) -> RequestContext {
    return RequestContext {
        id: context.id, request_id: context.request_id, deadline_ms: context.deadline_ms, has_deadline: context.has_deadline, cancelled: 1,
    }
}
fn deadline_state(now_ms: i32, deadline_ms: i32, cancelled: i32) -> DeadlineState {
    if cancelled == 1 then return DeadlineState::Cancelled if now_ms > deadline_ms then return DeadlineState::Expired return DeadlineState::Ready
}
fn deadline_is_ready(state: DeadlineState) -> i32 {
    if state == DeadlineState::Ready {
        return 1
    }
    return 0
}
fn deadline_is_expired(state: DeadlineState) -> i32 {
    if state == DeadlineState::Expired {
        return 1
    }
    return 0
}
fn deadline_is_cancelled(state: DeadlineState) -> i32 {
    if state == DeadlineState::Cancelled {
        return 1
    }
    return 0
}
fn request_context_state(context: RequestContext, now_ms: i32) -> DeadlineState {
    if context.cancelled == 1 {
        return DeadlineState::Cancelled
    }
    if context.has_deadline == 1 {
        return deadline_state(now_ms, context.deadline_ms, context.cancelled)
    }
    return DeadlineState::Ready
}
