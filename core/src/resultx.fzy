enum ErrorCode {
    InvalidInput,
    NotFound,
    Conflict,
    Timeout,
    Io,
    Internal,
}

enum ErrorClass {
    Transport,
    Parse,
    Timeout,
    Policy,
    Missing,
    Internal,
}

struct ErrorStatus {
    code: ErrorCode,
    class: ErrorClass,
    status: i32,
    retryable: i32,
}

fn normalize_status(status: i32) -> i32 {
    if status < 100 {
        return 500
    }
    if status > 599 {
        return 599
    }
    return status
}

fn from_status(status: i32) -> ErrorCode {
    let safe_status = normalize_status(status)
    if safe_status == 404 {
        return ErrorCode::NotFound
    }
    if safe_status == 408 || safe_status == 429 {
        return ErrorCode::Timeout
    }
    if safe_status == 409 {
        return ErrorCode::Conflict
    }
    if safe_status >= 400 && safe_status < 500 {
        return ErrorCode::InvalidInput
    }
    if safe_status >= 500 && safe_status < 600 {
        return ErrorCode::Io
    }
    return ErrorCode::Internal
}

fn classify(code: ErrorCode) -> ErrorClass {
    match code {
        ErrorCode::Io => return ErrorClass::Transport,
        ErrorCode::InvalidInput => return ErrorClass::Parse,
        ErrorCode::Timeout => return ErrorClass::Timeout,
        ErrorCode::Conflict => return ErrorClass::Policy,
        ErrorCode::NotFound => return ErrorClass::Missing,
        ErrorCode::Internal => return ErrorClass::Internal,
        _ => return ErrorClass::Internal,
    }
}

fn score(class: ErrorClass) -> i32 {
    match class {
        ErrorClass::Transport => return 11,
        ErrorClass::Parse => return 17,
        ErrorClass::Timeout => return 23,
        ErrorClass::Policy => return 31,
        ErrorClass::Missing => return 37,
        ErrorClass::Internal => return 43,
        _ => return 43,
    }
}

fn status_code(code: ErrorCode) -> i32 {
    match code {
        ErrorCode::InvalidInput => return 400,
        ErrorCode::NotFound => return 404,
        ErrorCode::Conflict => return 409,
        ErrorCode::Timeout => return 429,
        ErrorCode::Io => return 503,
        ErrorCode::Internal => return 500,
        _ => return 500,
    }
}

fn is_retryable(code: ErrorCode) -> i32 {
    match code {
        ErrorCode::Timeout => return 1,
        ErrorCode::Io => return 1,
        ErrorCode::Internal => return 1,
        _ => return 0,
    }
}

fn status_record(status: i32) -> ErrorStatus {
    let code = from_status(status)
    return ErrorStatus {
        code: code,
        class: classify(code),
        status: normalize_status(status),
        retryable: is_retryable(code),
    }
}

fn dominant(left: ErrorCode, right: ErrorCode) -> ErrorCode {
    let left_score = score(classify(left))
    let right_score = score(classify(right))
    if right_score > left_score {
        return right
    }
    return left
}

fn sample() -> i32 {
    let a = status_record(404)
    let b = status_record(503)
    let worst = dominant(a.code, b.code)
    return (score(a.class) + score(b.class) + status_code(worst) + a.retryable + b.retryable) % 251
}
