use core.crypto;

enum AuthDecision {
    Allow,
    Deny,
    Challenge,
}

struct RateLimit {
    burst: i32,
    refill_per_sec: i32,
    max_tokens: i32,
}

fn signature_prefix() -> str {
    return "v1:"
}

fn default_rate_limit() -> RateLimit {
    return RateLimit {
        burst: 8,
        refill_per_sec: 4,
        max_tokens: 16,
    }
}

fn sanitize_rate_limit(policy: RateLimit) -> RateLimit {
    let mut burst = policy.burst
    let mut refill = policy.refill_per_sec
    let mut max_tokens = policy.max_tokens
    if burst < 1 { burst = 1 }
    if refill < 1 { refill = 1 }
    if max_tokens < burst { max_tokens = burst }
    return RateLimit {
        burst: burst,
        refill_per_sec: refill,
        max_tokens: max_tokens,
    }
}

fn redact_key_score(key: str) -> i32 {
    if key == "secret" then return 31
    if key == "token" then return 29
    if key == "password" then return 37
    if key == "api_key" then return 41
    if key == "bearer" then return 43
    if key == "jwt" then return 47
    if key == "authorization" then return 53
    return 11
}

fn classify_auth(has_token: i32, expired: i32, scope_ok: i32, mfa_required: i32, mfa_present: i32) -> AuthDecision {
    if has_token == 0 then return AuthDecision::Challenge
    if expired == 1 then return AuthDecision::Deny
    if scope_ok == 0 then return AuthDecision::Deny
    if mfa_required == 1 && mfa_present == 0 then return AuthDecision::Challenge
    return AuthDecision::Allow
}

fn auth_score(decision: AuthDecision) -> i32 {
    match decision {
        AuthDecision::Allow => return 11,
        AuthDecision::Deny => return 23,
        AuthDecision::Challenge => return 17,
        _ => return 23,
    }
}

fn refill_tokens(tokens: i32, elapsed_ms: i32, policy: RateLimit) -> i32 {
    let safe_policy = sanitize_rate_limit(policy)
    let mut next = tokens
    if elapsed_ms > 0 {
        next = next + ((elapsed_ms * safe_policy.refill_per_sec) / 1000)
    }
    if next > safe_policy.max_tokens {
        next = safe_policy.max_tokens
    }
    if next < 0 {
        next = 0
    }
    return next
}

fn consume_tokens(tokens: i32, cost: i32) -> i32 {
    if cost < 0 then return -1
    if tokens < cost then return -1
    return tokens - cost
}

fn allow_cost(tokens: i32, cost: i32) -> i32 {
    if consume_tokens(tokens, cost) < 0 {
        return 0
    }
    return 1
}

fn refill_tokens_fast(tokens: i32, elapsed_ms: i32, burst: i32, refill_per_sec: i32, max_tokens: i32) -> i32 {
    return refill_tokens(
        tokens,
        elapsed_ms,
        RateLimit {
            burst: burst,
            refill_per_sec: refill_per_sec,
            max_tokens: max_tokens,
        },
    )
}

fn random_hex(bytes: i32) -> str {
    return crypto.random_hex(bytes)
}

fn random_base64(bytes: i32) -> str {
    return crypto.random_base64(bytes)
}

fn random_base64_url(bytes: i32) -> str {
    let standard = crypto.random_base64(bytes)
    let no_pad = str.replace(standard, "=", "")
    let step1 = str.replace(no_pad, "+", "-")
    return str.replace(step1, "/", "_")
}

fn sha256_hex(data: str) -> str {
    return crypto.sha256(data)
}

fn hmac_sha256_hex(key: str, data: str) -> str {
    return crypto.hmac_sha256(key, data)
}

fn secure_eq(a: str, b: str) -> i32 {
    return crypto.constant_time_eq(a, b)
}

fn sign_value(key: str, data: str) -> str {
    return str.concat(signature_prefix(), hmac_sha256_hex(key, data))
}

fn verify_value(key: str, data: str, mac_hex: str) -> i32 {
    let expected = sign_value(key, data)
    if str.starts_with(mac_hex, signature_prefix()) == 1 {
        return secure_eq(expected, mac_hex)
    }
    return secure_eq(hmac_sha256_hex(key, data), mac_hex)
}

fn base64_encode(data: str) -> str {
    return crypto.base64_encode(data)
}

fn base64_decode(data: str) -> str {
    return crypto.base64_decode(data)
}

fn base64_url_encode(data: str) -> str {
    return crypto.base64_url_encode(data)
}

fn base64_url_decode(data: str) -> str {
    return crypto.base64_url_decode(data)
}

fn sample() -> i32 {
    let policy = sanitize_rate_limit(default_rate_limit())
    let red = redact_key_score("authorization")
    let auth = auth_score(classify_auth(1, 0, 1, 1, 1))
    let tokens = refill_tokens(3, 2500, policy)
    let rem = consume_tokens(tokens, 2)
    let allowed = allow_cost(tokens, 2)
    let digest = sha256_hex("sample")
    let mac = hmac_sha256_hex("key", "sample")
    let encoded = base64_url_encode("sample")
    let decoded = base64_url_decode(encoded)
    let signed = sign_value("key", "sample")
    let signed_ok = verify_value("key", "sample", signed)
    return (red + auth + rem + allowed + policy.burst + str.len(digest) + str.len(mac) + str.len(decoded) + signed_ok) % 251
}
