enum LogLevel {
    Info,
    Warn,
    Error,
}

enum LogSink {
    Stdout,
    Stderr,
}

struct LogConfig {
    json: i32,
    include_correlation: i32,
    max_field_bytes: i32,
    sample_mod: i32,
    enabled: i32,
    sink: LogSink,
    min_level: LogLevel,
}

fn default_config() -> LogConfig {
    return LogConfig {
        json: 1,
        include_correlation: 1,
        max_field_bytes: 256,
        sample_mod: 1,
        enabled: 1,
        sink: LogSink::Stdout,
        min_level: LogLevel::Info,
    }
}

fn level_name(level: LogLevel) -> str {
    match level {
        LogLevel::Warn => return "warn",
        LogLevel::Error => return "error",
        _ => return "info",
    }
}

fn sink_name(sink: LogSink) -> str {
    match sink {
        LogSink::Stderr => return "stderr",
        _ => return "stdout",
    }
}

fn set_json_mode(enabled: i32) -> i32 {
    return log.set_json(enabled)
}

fn set_logging_enabled(enabled: i32) -> i32 {
    return log.set_enabled(enabled)
}

fn set_level_name(level: str) -> i32 {
    return log.set_level(level)
}

fn set_min_level(level: LogLevel) -> i32 {
    return set_level_name(level_name(level))
}

fn set_sink_name(sink: str) -> i32 {
    return log.set_sink(sink)
}

fn set_output_sink(sink: LogSink) -> i32 {
    return set_sink_name(sink_name(sink))
}

fn use_stdout() -> i32 {
    return set_output_sink(LogSink::Stdout)
}

fn use_stderr() -> i32 {
    return set_output_sink(LogSink::Stderr)
}

fn quiet() -> i32 {
    return log.set_enabled(0)
}

fn verbose() -> i32 {
    return log.set_enabled(1)
}

fn set_policy(config: LogConfig) -> i32 {
    let mut rc = 0
    rc = rc + set_logging_enabled(config.enabled)
    rc = rc + set_json_mode(config.json)
    rc = rc + set_output_sink(config.sink)
    rc = rc + set_min_level(config.min_level)
    return rc
}

fn clamp_field(value: str, max_bytes: i32) -> str {
    if max_bytes < 1 {
        return ""
    }
    if str.len(value) <= max_bytes {
        return value
    }
    return str.slice(value, 0, max_bytes)
}

fn should_sample(counter: i32, sample_mod: i32) -> i32 {
    if sample_mod <= 1 then return 1
    if counter < 0 then return 0
    if (counter % sample_mod) == 0 then return 1
    return 0
}

fn request_log(config: LogConfig, level: LogLevel, message: str, request_id: str, path: str, method: str) -> i32 {
    let msg = clamp_field(message, config.max_field_bytes)
    let rid = clamp_field(request_id, config.max_field_bytes)
    let p = clamp_field(path, config.max_field_bytes)
    let m = clamp_field(method, 16)
    discard set_policy(config)
    if level == LogLevel::Warn {
        discard log.warn(msg, log.fields(#{
            "request_id": json.str(rid),
            "path": json.str(p),
            "method": json.str(m),
            "level": json.str("warn"),
        }))
        return 2
    }
    if level == LogLevel::Error {
        discard log.error(msg, log.fields(#{
            "request_id": json.str(rid),
            "path": json.str(p),
            "method": json.str(m),
            "level": json.str("error"),
        }))
        return 3
    }
    discard log.info(msg, log.fields(#{
        "request_id": json.str(rid),
        "path": json.str(p),
        "method": json.str(m),
        "level": json.str("info"),
    }))
    return 1
}

fn sample() -> i32 {
    let cfg = default_config()
    if should_sample(100, cfg.sample_mod) == 1 {
        let mut acc = request_log(cfg, LogLevel::Info, "corelib.log.sample", "rid-sample", "/health", "GET")
        acc = acc + use_stdout()
        acc = acc + set_min_level(LogLevel::Warn)
        acc = acc + set_level_name("info")
        acc = acc + set_sink_name("stdout")
        acc = acc + set_logging_enabled(1)
        acc = acc + verbose()
        return acc % 251
    }
    return 0
}
