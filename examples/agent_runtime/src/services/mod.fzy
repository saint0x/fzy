use core.fs;
use core.log;
use core.path;
use core.security;
use core.storage;

use model;
use runtime;

fn log_fields2(k1: str, v1: str, k2: str, v2: str) -> str {
    let fields = map.new()
    discard map.set(fields, k1, v1)
    discard map.set(fields, k2, v2)
    return log.fields(fields)
}

fn audit_path() -> str {
    return path.join("tmp", "agent_runtime.audit.jsonl")
}

fn json_obj3(k1: str, v1: str, k2: str, v2: str, k3: str, v3: str) -> str {
    let obj = map.new()
    discard map.set(obj, k1, v1)
    discard map.set(obj, k2, v2)
    discard map.set(obj, k3, v3)
    return json.object(obj)
}

fn session_auth_ok(workspace_id: str, session: model.SessionRecord) -> i32 {
    return security.verify(
        security.default_signer(),
        "agent-runtime-secret",
        model.session_signing_input(workspace_id, session.session_id),
        session.auth_mac,
    )
}

fn plan_value(workspace_id: str, user: str, request: str) -> model.PlanRecord {
    let session = model.session(workspace_id, user)
    let mode = model.task_mode(request)
    let auth_ok = session_auth_ok(workspace_id, session)
    return model.plan(request, mode, session, runtime.parallel_budget(), auth_ok)
}

fn plan_json(workspace_id: str, user: str, request: str) -> str {
    return model.plan_json(plan_value(workspace_id, user, request))
}

fn append_audit(event: str, payload_json: str) -> i32 {
    discard fs.mkdir("tmp")
    let line = str.concat(
        json_obj3("event", json.str(event), "status", json.str("ok"), "payload", payload_json),
        "\n",
    )
    discard storage.atomic_append(audit_path(), line)
    return 0
}

fn run_once(workspace_id: str, user: str, request: str) -> str {
    let payload = model.plan_json(plan_value(workspace_id, user, request))
    discard append_audit("plan_once", payload)
    log.info("agent_runtime.plan", log_fields2("mode", model.task_mode(request), "workspace", workspace_id))
    return payload
}

fn doctor_value() -> model.DoctorRecord {
    return model.doctor(model.tool_catalog_count(), audit_path(), runtime.parallel_budget())
}

fn doctor_json() -> str {
    return model.doctor_json(doctor_value())
}
