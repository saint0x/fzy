use core.security;

test "det_signed_session" {
    let session = model.session("workspace-main", "operator")
    if security.verify(
        security.default_signer(),
        "agent-runtime-secret",
        str.concat("workspace-main", str.concat(":", session.session_id)),
        session.auth_mac,
    ) != 1 {
        checkpoint()
    }
}

test "det_tool_catalog" {
    if model.tool_catalog_count() != 3 {
        checkpoint()
    }
    if model.tool_catalog_at(2).id != "parallel_plan" || model.tool_catalog_at(1).id != "repo_inspect" {
        checkpoint()
    }
}

test "det_parallel_budget" {
    if runtime.parallel_budget() != 20 {
        checkpoint()
    }
}

test "det_plan_local_inspect" {
    let plan = services.plan_value("workspace-main", "operator", "inspect repo files and cite exact paths")
    if plan.mode != "local_inspect" {
        checkpoint()
    }
    if plan.auth_ok != 1 {
        checkpoint()
    }
}
