use fzbounds;
use model;
use runtime;

fn parse_i32(text: str) -> i32 {
    let trimmed = str.trim(text)
    if trimmed == "" {
        return 0
    }
    let mut idx = 0
    let mut sign = 1
    if str.slice(trimmed, 0, 1) == "-" {
        sign = -1
        idx = 1
    }
    let mut value = 0
    while idx < str.len(trimmed) {
        let ch = str.slice(trimmed, idx, idx + 1)
        if ch == "0" { value = (value * 10) + 0 }
        if ch == "1" { value = (value * 10) + 1 }
        if ch == "2" { value = (value * 10) + 2 }
        if ch == "3" { value = (value * 10) + 3 }
        if ch == "4" { value = (value * 10) + 4 }
        if ch == "5" { value = (value * 10) + 5 }
        if ch == "6" { value = (value * 10) + 6 }
        if ch == "7" { value = (value * 10) + 7 }
        if ch == "8" { value = (value * 10) + 8 }
        if ch == "9" { value = (value * 10) + 9 }
        idx = idx + 1
    }
    return value * sign
}

fn json_i32_field(payload: JsonHandle, key: str) -> i32 {
    let item = json.get(payload, key)
    return parse_i32(json.get_str(item, "raw"))
}

fn framework_report_json_value() -> str {
    return model.framework_report_json("ok", fzbounds.inspect_json())
}

fn alignment_value(local: model.ServiceConfig) -> model.AlignmentReport {
    let inspect = json.parse(fzbounds.inspect_json())
    let runtime_report = json.get(inspect, "runtime")
    let runtime_budget = json.get(runtime_report, "budget")
    let fzweb = json.get(inspect, "fzweb")
    let auth_profile = json.get(inspect, "auth_profile")
    let request_ok = if local.request_budget_bytes <= json_i32_field(fzweb, "request_budget_bytes") { 1 } else { 0 }
    let header_ok = if local.header_capacity <= json_i32_field(fzweb, "header_capacity") { 1 } else { 0 }
    let body_ok = if local.body_capacity_bytes <= json_i32_field(fzweb, "body_capacity_bytes") { 1 } else { 0 }
    let queue_ok = if local.worker_queue_capacity <= json_i32_field(runtime_budget, "max_queue_entries") { 1 } else { 0 }
    let session_ok = if local.session_capacity <= json_i32_field(auth_profile, "session_capacity") { 1 } else { 0 }
    let memory_ok = if local.warm_memory_bytes <= json_i32_field(runtime_report, "max_memory_bytes") { 1 } else { 0 }
    let observed_mode = json.get_str(runtime_report, "mode")
    let mode_ok = if observed_mode == "" {
        if local.runtime_mode == "strict" { 1 } else { 0 }
    } else {
        if local.runtime_mode == observed_mode { 1 } else { 0 }
    }
    return model.alignment(
        if request_ok == 1 && header_ok == 1 && body_ok == 1 && queue_ok == 1 && session_ok == 1 && memory_ok == 1 && mode_ok == 1 { "ok" } else { "mismatch" },
        request_ok,
        header_ok,
        body_ok,
        queue_ok,
        session_ok,
        memory_ok,
        mode_ok,
    )
}

fn doctor_value() -> model.DoctorSummary {
    return model.doctor("bounds_service", model.config(), runtime.boot())
}

fn doctor_json() -> str {
    return model.doctor_json(doctor_value())
}

fn framework_value() -> model.FrameworkSummary {
    let local = model.config()
    return model.framework_summary("bounds_service", local, framework_report_json_value(), alignment_value(local))
}

fn framework_json() -> str {
    return model.framework_json(framework_value())
}

fn gate_value() -> model.GateSummary {
    let local = model.config()
    let alignment = alignment_value(local)
    return model.gate(alignment.status, local, alignment)
}

fn gate_json() -> str {
    return model.gate_json(gate_value())
}
