use fzbounds;
use model;
use runtime;

fn framework_report_value() -> model.FrameworkReport {
    let inspect_raw = fzbounds.inspect_json()
    return model.framework_report(
        "ok",
        inspect_raw,
        model.framework_fzweb(
            fzbounds.api.inspect_fzweb_request_budget_bytes(),
            fzbounds.api.inspect_fzweb_header_capacity(),
            fzbounds.api.inspect_fzweb_body_capacity_bytes(),
        ),
        model.framework_runtime(
            fzbounds.api.inspect_runtime_mode(),
            fzbounds.api.inspect_runtime_max_memory_bytes(),
            model.framework_budget(fzbounds.api.inspect_runtime_max_queue_entries()),
        ),
        model.framework_auth_profile(fzbounds.api.inspect_auth_session_capacity()),
    )
}

fn alignment_value(local: model.ServiceConfig, framework: model.FrameworkReport) -> model.AlignmentReport {
    let request_ok = if local.request_budget_bytes <= framework.fzweb.request_budget_bytes { 1 } else { 0 }
    let header_ok = if local.header_capacity <= framework.fzweb.header_capacity { 1 } else { 0 }
    let body_ok = if local.body_capacity_bytes <= framework.fzweb.body_capacity_bytes { 1 } else { 0 }
    let queue_ok = if local.worker_queue_capacity <= framework.runtime.budget.max_queue_entries { 1 } else { 0 }
    let session_ok = if local.session_capacity <= framework.auth_profile.session_capacity { 1 } else { 0 }
    let memory_ok = if local.warm_memory_bytes <= framework.runtime.max_memory_bytes { 1 } else { 0 }
    let observed_mode = framework.runtime.mode
    let mode_ok = if observed_mode == "" {
        if local.runtime_mode == "strict" { 1 } else { 0 }
    } else {
        if local.runtime_mode == observed_mode { 1 } else { 0 }
    }
    return model.alignment(
        if request_ok == 1 && header_ok == 1 && body_ok == 1 && queue_ok == 1 && session_ok == 1 && memory_ok == 1 && mode_ok == 1 { "ok" } else { "mismatch" },
        request_ok,
        header_ok,
        body_ok,
        queue_ok,
        session_ok,
        memory_ok,
        mode_ok,
    )
}

fn doctor_value() -> model.DoctorSummary {
    return model.doctor("bounds_service", model.config(), runtime.boot())
}

fn doctor_json() -> str {
    return model.doctor_json(doctor_value())
}

fn framework_value() -> model.FrameworkSummary {
    let local = model.config()
    let framework = framework_report_value()
    return model.framework_summary("bounds_service", local, framework, alignment_value(local, framework))
}

fn framework_json() -> str {
    return model.framework_json(framework_value())
}

fn gate_value() -> model.GateSummary {
    let local = model.config()
    let framework = framework_report_value()
    let alignment = alignment_value(local, framework)
    return model.gate(alignment.status, local, alignment)
}

fn gate_json() -> str {
    return model.gate_json(gate_value())
}
