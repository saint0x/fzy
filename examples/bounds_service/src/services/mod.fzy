use fzbounds;
use model;
use runtime;

fn parse_i32(text: str) -> i32 {
    let trimmed = str.trim(text)
    if trimmed == "" {
        return 0
    }
    let mut idx = 0
    let mut sign = 1
    if str.slice(trimmed, 0, 1) == "-" {
        sign = -1
        idx = 1
    }
    let mut value = 0
    while idx < str.len(trimmed) {
        let ch = str.slice(trimmed, idx, idx + 1)
        if ch == "0" { value = (value * 10) + 0 }
        if ch == "1" { value = (value * 10) + 1 }
        if ch == "2" { value = (value * 10) + 2 }
        if ch == "3" { value = (value * 10) + 3 }
        if ch == "4" { value = (value * 10) + 4 }
        if ch == "5" { value = (value * 10) + 5 }
        if ch == "6" { value = (value * 10) + 6 }
        if ch == "7" { value = (value * 10) + 7 }
        if ch == "8" { value = (value * 10) + 8 }
        if ch == "9" { value = (value * 10) + 9 }
        idx = idx + 1
    }
    return value * sign
}

fn bool_json(value: i32) -> str {
    if value == 1 {
        return "true"
    }
    return "false"
}

fn json_i32(value: i32) -> str {
    return str.from_i32(value)
}

fn json_bool(value: i32) -> str {
    return bool_json(value)
}

fn framework_report_json() -> str {
    let inspect_raw = fzbounds.inspect_json()
    let payload = map.new()
    discard map.set(payload, "status", json.str("ok"))
    discard map.set(payload, "inspect", inspect_raw)
    discard map.set(payload, "inspect_raw", json.str(inspect_raw))
    return json.object(payload)
}

fn alignment_json_from(local_json: str, framework_json: str) -> str {
    let local = json.parse(local_json)
    let framework = json.parse(framework_json)
    let fzweb = json.parse(json.get_str(framework, "fzweb"))
    let runtime_payload = json.parse(json.get_str(framework, "runtime"))
    let runtime_budget = json.parse(json.get_str(runtime_payload, "budget"))
    let auth_profile = json.parse(json.get_str(framework, "auth_profile"))

    let request_ok = if parse_i32(json.get_str(local, "request_budget_bytes")) <= parse_i32(json.get_str(fzweb, "request_budget_bytes")) { 1 } else { 0 }
    let header_ok = if parse_i32(json.get_str(local, "header_capacity")) <= parse_i32(json.get_str(fzweb, "header_capacity")) { 1 } else { 0 }
    let body_ok = if parse_i32(json.get_str(local, "body_capacity_bytes")) <= parse_i32(json.get_str(fzweb, "body_capacity_bytes")) { 1 } else { 0 }
    let queue_ok = if parse_i32(json.get_str(local, "worker_queue_capacity")) <= parse_i32(json.get_str(runtime_budget, "max_queue_entries")) { 1 } else { 0 }
    let session_ok = if parse_i32(json.get_str(local, "session_capacity")) <= parse_i32(json.get_str(auth_profile, "session_capacity")) { 1 } else { 0 }
    let memory_ok = if parse_i32(json.get_str(local, "warm_memory_bytes")) <= parse_i32(json.get_str(runtime_payload, "max_memory_bytes")) { 1 } else { 0 }
    let observed_mode = json.get_str(runtime_payload, "mode")
    let mode_ok = if observed_mode == "" {
        if json.get_str(local, "runtime_mode") == "strict" { 1 } else { 0 }
    } else {
        if json.get_str(local, "runtime_mode") == observed_mode { 1 } else { 0 }
    }

    let payload = map.new()
    discard map.set(payload, "status", json.str(if request_ok == 1 && header_ok == 1 && body_ok == 1 && queue_ok == 1 && session_ok == 1 && memory_ok == 1 && mode_ok == 1 { "ok" } else { "mismatch" }))
    discard map.set(payload, "request_budget_ok", json_bool(request_ok))
    discard map.set(payload, "header_capacity_ok", json_bool(header_ok))
    discard map.set(payload, "body_capacity_ok", json_bool(body_ok))
    discard map.set(payload, "queue_capacity_ok", json_bool(queue_ok))
    discard map.set(payload, "session_capacity_ok", json_bool(session_ok))
    discard map.set(payload, "warm_memory_ok", json_bool(memory_ok))
    discard map.set(payload, "runtime_mode_ok", json_bool(mode_ok))
    return json.object(payload)
}

fn doctor_json() -> str {
    let cfg = model.config()
    let payload = map.new()
    discard map.set(payload, "framework", json.str("bounds_service"))
    discard map.set(payload, "local_contract", model.local_contract_json(cfg))
    discard map.set(payload, "boot_score", json_i32(runtime.boot()))
    return json.object(payload)
}

fn framework_json() -> str {
    let local = model.local_contract_json(model.config())
    let framework = framework_report_json()
    let framework_payload = json.parse(framework)
    let payload = map.new()
    discard map.set(payload, "framework", json.str("bounds_service"))
    discard map.set(payload, "local_contract", local)
    discard map.set(payload, "framework_report", framework)
    if json.get_str(framework_payload, "status") == "ok" {
        discard map.set(payload, "alignment", alignment_json_from(local, json.get_str(framework_payload, "inspect_raw")))
    } else {
        discard map.set(payload, "alignment", "{\"status\":\"framework_unavailable\"}")
    }
    return json.object(payload)
}

fn gate_json() -> str {
    let local = model.local_contract_json(model.config())
    let framework = framework_report_json()
    let framework_payload = json.parse(framework)
    let alignment = if json.get_str(framework_payload, "status") == "ok" {
        alignment_json_from(local, json.get_str(framework_payload, "inspect_raw"))
    } else {
        "{\"status\":\"framework_unavailable\"}"
    }
    let payload = map.new()
    discard map.set(payload, "status", json.str(json.get_str(json.parse(alignment), "status")))
    discard map.set(payload, "local_contract", local)
    discard map.set(payload, "alignment", alignment)
    return json.object(payload)
}
