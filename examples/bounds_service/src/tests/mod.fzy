use services;

test "det_local_contract" {
    let doctor = services.doctor_json()
    if str.contains(doctor, "\"framework\":\"bounds_service\"") == 0 {
        checkpoint()
    }
    if str.contains(doctor, "\"request_budget_bytes\":32768") == 0 {
        checkpoint()
    }
}

test "det_gate_alignment" {
    let gate = services.gate_json()
    if str.contains(gate, "\"status\":\"ok\"") == 0 {
        checkpoint()
    }
    if str.contains(gate, "\"runtime_mode_ok\":true") == 0 {
        checkpoint()
    }
}
