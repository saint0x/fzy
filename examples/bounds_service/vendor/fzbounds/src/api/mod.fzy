use services;
fn library_name() -> str {
    return "fzbounds"
}
fn touch() -> i32 {
    return services.surface_score()
}
fn doctor_json() -> str {
    return services.doctor_json()
}
fn inspect_json() -> str {
    return services.inspect_json()
}
fn inspect_runtime_mode() -> str {
    return services.inspect().runtime.mode
}
fn inspect_runtime_max_memory_bytes() -> i32 {
    return services.inspect().runtime.max_memory_bytes
}
fn inspect_runtime_max_queue_entries() -> i32 {
    return services.inspect().runtime.budget.max_queue_entries
}
fn inspect_fzweb_request_budget_bytes() -> i32 {
    return services.inspect().integrations.fzweb.request_budget_bytes
}
fn inspect_fzweb_header_capacity() -> i32 {
    return services.inspect().integrations.fzweb.header_capacity
}
fn inspect_fzweb_body_capacity_bytes() -> i32 {
    return services.inspect().integrations.fzweb.body_capacity_bytes
}
fn inspect_auth_session_capacity() -> i32 {
    return services.inspect().integrations.auth.session_capacity
}
