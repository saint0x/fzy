use model;
fn peak_of(left: i32, right: i32) -> i32 {
    if left >= right {
        return left
    }
    return right
}
fn json_text_array(items: ListHandle, start: i32, len: i32) -> str {
    let payload = list.new()
    let mut idx = 0
    while idx<len {
        discard list.push(payload, json.str(list.get(items, start + idx)))
        idx = idx + 1
    }
    return json.array(payload)
}
fn map_entry_json(key: str, value: str) -> str {
    let payload = map.new()
    discard map.set(payload, "key", json.str(key))
    discard map.set(payload, "value", json.str(value))
    return json.object(payload)
}
fn json_map_entries(entries: ListHandle, len: i32) -> str {
    let payload = list.new()
    let mut idx = 0
    while idx<len {
        let base = idx * 2
        discard list.push(payload, map_entry_json(list.get(entries, base), list.get(entries, base + 1)))
        idx = idx + 1
    }
    return json.array(payload)
}
fn list_make(capacity: i32) -> model.BoundedList {
    return model.bounded_list(capacity)
}
fn list_push_text(items: model.BoundedList, value: str) -> model.BoundedList {
    if items.len >= items.capacity {
        return model.bounded_list_full(items.capacity, items.len, items.peak_len, items.overflows + 1, items.items, "list capacity exceeded")
    }
    discard list.push(items.items, value)
    let next_len = items.len + 1
    return model.bounded_list_full(items.capacity, next_len, peak_of(items.peak_len, next_len), items.overflows, items.items, "")
}
fn list_len(items: model.BoundedList) -> i32 {
    return items.len
}
fn map_make(capacity: i32) -> model.BoundedMap {
    return model.bounded_map(capacity)
}
fn map_set_text(entries: model.BoundedMap, key: str, value: str) -> model.BoundedMap {
    if entries.len >= entries.capacity {
        return model.bounded_map_full(entries.capacity, entries.len, entries.peak_len, entries.overflows + 1, entries.entries, "map capacity exceeded")
    }
    discard list.push(entries.entries, key)
    discard list.push(entries.entries, value)
    let next_len = entries.len + 1
    return model.bounded_map_full(entries.capacity, next_len, peak_of(entries.peak_len, next_len), entries.overflows, entries.entries, "")
}
fn map_get_text(entries: model.BoundedMap, key: str) -> str {
    let mut idx = 0
    while idx<entries.len {
        let base = idx * 2
        if list.get(entries.entries, base) == key {
            return list.get(entries.entries, base + 1)
        }
        idx = idx + 1
    }
    return ""
}
fn queue_make(capacity: i32) -> model.BoundedQueue {
    return model.bounded_queue(capacity)
}
fn queue_push_text(queue: model.BoundedQueue, value: str) -> model.BoundedQueue {
    if queue.len >= queue.capacity {
        return model.bounded_queue_full(queue.capacity, queue.len, queue.peak_len, queue.head, queue.overflows + 1, queue.items, "queue capacity exceeded")
    }
    discard list.push(queue.items, value)
    let next_len = queue.len + 1
    return model.bounded_queue_full(queue.capacity, next_len, peak_of(queue.peak_len, next_len), queue.head, queue.overflows, queue.items, "")
}
fn queue_peek_text(queue: model.BoundedQueue) -> str {
    if queue.len <= 0 {
        return ""
    }
    return list.get(queue.items, queue.head)
}
fn queue_pop(queue: model.BoundedQueue) -> model.BoundedQueue {
    if queue.len <= 0 {
        return queue
    }
    return model.bounded_queue_full(queue.capacity, queue.len - 1, queue.peak_len, queue.head + 1, queue.overflows, queue.items, "")
}
fn channel_make(capacity: i32) -> model.BoundedChannel {
    return model.bounded_channel(capacity)
}
fn channel_send_text(channel: model.BoundedChannel, value: str) -> model.BoundedChannel {
    if channel.len >= channel.capacity {
        return model.bounded_channel_full(channel.capacity, channel.len, channel.peak_len, channel.head, channel.overflows + 1, channel.items, "channel capacity exceeded")
    }
    discard list.push(channel.items, value)
    let next_len = channel.len + 1
    return model.bounded_channel_full(channel.capacity, next_len, peak_of(channel.peak_len, next_len), channel.head, channel.overflows, channel.items, "")
}
fn channel_recv(channel: model.BoundedChannel) -> model.BoundedChannel {
    if channel.len <= 0 {
        return channel
    }
    return model.bounded_channel_full(channel.capacity, channel.len - 1, channel.peak_len, channel.head + 1, channel.overflows, channel.items, "")
}
fn buffer_make(capacity_bytes: i32) -> model.BoundedBuffer {
    return model.bounded_buffer(capacity_bytes)
}
fn buffer_write_text(buffer: model.BoundedBuffer, value: str) -> model.BoundedBuffer {
    let next_used = buffer.used_bytes + str.len(value)
    if next_used>buffer.capacity_bytes {
        return model.bounded_buffer_full(buffer.capacity_bytes, buffer.used_bytes, buffer.peak_bytes, buffer.overflows + 1, buffer.data, "buffer capacity exceeded")
    }
    let next_data = str.concat(buffer.data, value)
    return model.bounded_buffer_full(buffer.capacity_bytes, next_used, peak_of(buffer.peak_bytes, next_used), buffer.overflows, next_data, "")
}
fn json_list(items: model.BoundedList) -> str {
    let payload = map.new()
    discard map.set(payload, "capacity", str.from_i32(items.capacity))
    discard map.set(payload, "len", str.from_i32(items.len))
    discard map.set(payload, "peak_len", str.from_i32(items.peak_len))
    discard map.set(payload, "overflows", str.from_i32(items.overflows))
    discard map.set(payload, "last_error", json.str(items.last_error))
    discard map.set(payload, "items", json_text_array(items.items, 0, items.len))
    return json.object(payload)
}
fn json_map(items: model.BoundedMap) -> str {
    let payload = map.new()
    discard map.set(payload, "capacity", str.from_i32(items.capacity))
    discard map.set(payload, "len", str.from_i32(items.len))
    discard map.set(payload, "peak_len", str.from_i32(items.peak_len))
    discard map.set(payload, "overflows", str.from_i32(items.overflows))
    discard map.set(payload, "last_error", json.str(items.last_error))
    discard map.set(payload, "entries", json_map_entries(items.entries, items.len))
    return json.object(payload)
}
fn json_queue(items: model.BoundedQueue) -> str {
    let payload = map.new()
    discard map.set(payload, "capacity", str.from_i32(items.capacity))
    discard map.set(payload, "len", str.from_i32(items.len))
    discard map.set(payload, "peak_len", str.from_i32(items.peak_len))
    discard map.set(payload, "head", str.from_i32(items.head))
    discard map.set(payload, "overflows", str.from_i32(items.overflows))
    discard map.set(payload, "last_error", json.str(items.last_error))
    discard map.set(payload, "items", json_text_array(items.items, items.head, items.len))
    return json.object(payload)
}
fn json_channel(items: model.BoundedChannel) -> str {
    let payload = map.new()
    discard map.set(payload, "capacity", str.from_i32(items.capacity))
    discard map.set(payload, "len", str.from_i32(items.len))
    discard map.set(payload, "peak_len", str.from_i32(items.peak_len))
    discard map.set(payload, "head", str.from_i32(items.head))
    discard map.set(payload, "overflows", str.from_i32(items.overflows))
    discard map.set(payload, "last_error", json.str(items.last_error))
    discard map.set(payload, "items", json_text_array(items.items, items.head, items.len))
    return json.object(payload)
}
fn json_buffer(items: model.BoundedBuffer) -> str {
    return model.bounded_buffer_json(items)
}
