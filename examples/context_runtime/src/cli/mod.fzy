use core.log;
use core.process;
use core.term;
use core.text;

use model;
use services;

fn print_help() -> i32 {
    discard term.print_line("context_runtime")
    discard term.print_line("  frame <request>      assemble a deterministic context frame")
    discard term.print_line("  compact <request>    summarize selected evidence")
    discard term.print_line("  doctor <request>     show mode and selected memory count")
    return 0
}

fn run(command: str) -> i32 {
    let request = process.argv_or(2, "inspect repo paths and explain the relevant modules")
    if command == "help" || command == "--help" {
        log.quiet()
        return print_help()
    }
    if command == "compact" {
        discard term.print_line(text.indent(services.compact_json("workspace-main", "session-a", request), "  "))
        return 0
    }
    if command == "doctor" {
        discard term.print_line(text.indent(services.doctor_json(request), "  "))
        return 0
    }
    let frame = services.frame_json("workspace-main", "session-a", request)
    log.info("context_runtime.frame", services.json_obj2("mode", json.str(model.task_mode(request)), "command", json.str(command)))
    discard term.print_line(text.indent(frame, "  "))
    return 0
}
