use model;

fn candidate_memory(workspace_id: str, session_id: str) -> model.MemoryList {
    let mut records = model.memory_list()
    records = model.append_memory(records, model.memory("mem-1", "workspace", "fact", "planner uses scoped memory and exact repo paths", 8, 9, 1, workspace_id, session_id))
    records = model.append_memory(records, model.memory("mem-2", "workspace", "policy", "answers must cite exact file paths for repo inspection", 7, 9, 1, workspace_id, ""))
    records = model.append_memory(records, model.memory("mem-3", "global", "fact", "prefer deterministic traces and strict replay evidence", 8, 8, 0, "", ""))
    records = model.append_memory(records, model.memory("mem-4", "session", "note", "follow-up should stay concise unless asked for depth", 5, 7, 0, workspace_id, session_id))
    return records
}

fn selected_memory(request: str, workspace_id: str, session_id: str) -> model.MemoryList {
    let mut selected = model.memory_list()
    let items = candidate_memory(workspace_id, session_id)
    let mut idx = 0
    while idx < model.memory_count(items) {
        let value = model.memory_at(items, idx)
        if model.score_memory(value, request, workspace_id, session_id) >= 90 {
            selected = model.append_memory(selected, value)
        }
        idx += 1
    }
    return selected
}

fn frame_value(workspace_id: str, session_id: str, request: str) -> model.ContextFrame {
    let selected = selected_memory(request, workspace_id, session_id)
    return model.frame(
        "Assemble answers from selected memory before expanding tool work",
        selected,
        model.planner(model.memory_count(selected), model.pinned_count(selected), request),
        model.protocol(request),
        request,
    )
}

fn frame_json(workspace_id: str, session_id: str, request: str) -> str {
    return model.frame_json(frame_value(workspace_id, session_id, request))
}

fn compact_value(workspace_id: str, session_id: str, request: str) -> model.CompactSummary {
    let selected = selected_memory(request, workspace_id, session_id)
    return model.compact(
        "ok",
        workspace_id,
        session_id,
        model.memory_count(selected),
        str.concat("Compacted context for request: ", request),
    )
}

fn compact_json(workspace_id: str, session_id: str, request: str) -> str {
    return model.compact_json(compact_value(workspace_id, session_id, request))
}

fn doctor_value(request: str) -> model.DoctorSummary {
    let selected = selected_memory(request, "workspace-main", "session-a")
    return model.doctor(model.task_mode(request), model.memory_count(selected))
}

fn doctor_json(request: str) -> str {
    return model.doctor_json(doctor_value(request))
}
