use core.gpu;
use core.simd;
use core.thread;

mod api;
mod cli;
mod model;
mod runtime;
mod services;
mod tests;

struct FrameStats {
    sum: i32,
    min: i32,
    max: i32,
    hot: i32,
}

kernel fn ripple_ascii(output: GpuSlice<i32>, width: i32, height: i32, phase: i32) -> void {
    let i = gpu.global_id_x()
    let n = width * height
    if i < n {
        let y = i / width
        let x = i - (y * width)
        let dx = (x * 2) - width
        let dy = (y * 2) - height
        let ring = ((dx * dx) + (dy * dy) + (phase * 21)) / 11
        let digit = ring - ((ring / 10) * 10)
        output[i] = 9 - digit
    }
}

fn glyph(value: i32) -> str {
    if value <= 0 { return " " }
    if value == 1 { return "." }
    if value == 2 { return ":" }
    if value == 3 { return "-" }
    if value == 4 { return "=" }
    if value == 5 { return "+" }
    if value == 6 { return "*" }
    if value == 7 { return "#" }
    if value == 8 { return "%" }
    return "@"
}

fn render_frame(output: Vec<i32>) -> str {
    let mut text = ""
    let mut idx = 0
    while idx < model.cell_count() {
        text = str.concat(text, glyph(output[idx]))
        idx = idx + 1
        let row = idx / model.width()
        if idx == row * model.width() {
            text = str.concat(text, "\n")
        }
    }
    return text
}

fn aggregate_frame(output: Vec<i32>) -> FrameStats {
    let mut idx = 0
    let mut sum = 0
    let mut low = 99
    let mut high = -99
    let mut hot = 0
    while idx < model.cell_count() {
        let block: [i32; 4] = [output[idx], output[idx + 1], output[idx + 2], output[idx + 3]]
        let vec = simd.i32x4_load(block)
        sum = sum + simd.i32x4_reduce_add(vec)
        let local_min = simd.i32x4_reduce_min(vec)
        let local_max = simd.i32x4_reduce_max(vec)
        if local_min < low {
            low = local_min
        }
        if local_max > high {
            high = local_max
        }
        if output[idx] >= 8 {
            hot = hot + 1
        }
        if output[idx + 1] >= 8 {
            hot = hot + 1
        }
        if output[idx + 2] >= 8 {
            hot = hot + 1
        }
        if output[idx + 3] >= 8 {
            hot = hot + 1
        }
        idx = idx + 4
    }
    return FrameStats { sum: sum, min: low, max: high, hot: hot }
}

fn validate_frame(stats: FrameStats) -> i32 {
    if stats.min < 0 {
        return 61
    }
    if stats.max > 9 {
        return 62
    }
    if stats.sum < model.min_sum() {
        return 63
    }
    if stats.sum > model.max_sum() {
        return 64
    }
    return 0
}

host fn render_animation() -> i32 {
    let dev = gpu.default_device()
    let frame_buf: GpuBuffer<i32> = gpu.alloc_i32(dev, model.cell_count())
    defer gpu.free(frame_buf)
    let mut frame = 0
    while frame < model.frame_count() {
        let event = gpu.launch4(
            ripple_ascii,
            model.grid_size(),
            model.block_size(),
            gpu.slice(frame_buf, 0, model.cell_count()),
            model.width(),
            model.height(),
            frame,
        )
        gpu.wait(event)
        let output: Vec<i32> = gpu.download_i32(frame_buf)
        let stats = aggregate_frame(output)
        let stats_rc = validate_frame(stats)
        if stats_rc != 0 {
            discard term.write(str.concat(str.concat("gpu_ascii_ripple status=fail code=", str.from_i32(stats_rc)), "\n"))
            return stats_rc
        }
        discard term.write(str.concat(str.concat("frame ", str.from_i32(frame)), " "))
        discard term.write(str.concat(str.concat("sum=", str.from_i32(stats.sum)), " "))
        discard term.write(str.concat(str.concat("min=", str.from_i32(stats.min)), " "))
        discard term.write(str.concat(str.concat("max=", str.from_i32(stats.max)), " "))
        discard term.write(str.concat(str.concat("hot=", str.from_i32(stats.hot)), "\n"))
        discard term.write(render_frame(output))
        discard term.write("\n")
        frame = frame + 1
    }
    discard term.write("gpu_ascii_ripple status=ok kernel=ripple_ascii renderer=cpu_ascii_simd_aggregate\n")
    return 0
}

host fn main() -> i32 {
    discard api.touch()
    let rc = runtime.boot()
    if rc != 0 {
        return rc
    }
    discard cli.touch()
    let dev_name = services.describe_default_device()
    discard term.write(str.concat(str.concat("gpu_ascii_ripple device=", dev_name), "\n"))
    return render_animation()
}
