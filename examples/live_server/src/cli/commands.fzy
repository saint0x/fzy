use core.log;
struct CliLogFields {
    component: str, phase: str,
}
fn cli_log_fields(phase: str) -> CliLogFields {
    return CliLogFields {
        component: "cli", phase: phase,
    };
}
fn cli_log_fields_text(value: CliLogFields) -> str {
    let fields = map.new();
    discard map.set(fields, "component", value.component);
    discard map.set(fields, "phase", value.phase);
    return log.fields(fields);
}
fn boot() -> i32 {
    discard env.get("FZWEB_BIND");
    discard env.get("SERVICE_ENV");
    log.info("cli.boot", cli_log_fields_text(cli_log_fields("boot")));
    return 0;
}
