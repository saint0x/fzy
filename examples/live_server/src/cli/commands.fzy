use core.log;

fn fields2(k1: str, v1: str, k2: str, v2: str) -> str {
    let fields = map.new();
    discard map.set(fields, k1, v1);
    discard map.set(fields, k2, v2);
    return log.fields(fields);
}

fn boot() -> i32 {
    discard env.get("FZWEB_BIND");
    discard env.get("SERVICE_ENV");
    log.info("cli.boot", fields2("component", "cli", "phase", "boot"));
    return 0;
}
