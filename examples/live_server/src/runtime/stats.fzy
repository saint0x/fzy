use core.thread;
use core.time;
use core.fs;
use core.log;
struct RuntimeStatsLogFields {
    component: str, phase: str,
}
fn runtime_stats_log_fields(phase: str) -> RuntimeStatsLogFields {
    return RuntimeStatsLogFields {
        component: "runtime.stats", phase: phase,
    };
}
fn runtime_stats_log_fields_text(value: RuntimeStatsLogFields) -> str {
    let fields = map.new();
    discard map.set(fields, "component", value.component);
    discard map.set(fields, "phase", value.phase);
    return log.fields(fields);
}
fn sample() -> i32 {
    let stats_file_ref = fs.open("live_server.runtime.stats");
    defer fs.close(stats_file_ref);
    checkpoint();
    log.info("runtime.stats", runtime_stats_log_fields_text(runtime_stats_log_fields("sample_a")));
    log.info("runtime.stats", runtime_stats_log_fields_text(runtime_stats_log_fields("sample_b")));
    log.info("runtime.stats", runtime_stats_log_fields_text(runtime_stats_log_fields("sample_c")));
    discard time.now();
    discard fs.write(stats_file_ref, "runtime.stats.sample\n");
    yield();
    return 0;
}
