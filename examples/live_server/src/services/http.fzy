use core.http;
use core.time;

fn listen_public() -> i32 {
    let listener_owned: HttpHandle = http.bind("127.0.0.1:8080");
    http.listen(listener_owned);
    close(listener_owned);
    discard time.now();
    return 0;
}

fn route_health() -> i32 {
    let conn_owned: HttpHandle = http.accept();
    http.read(conn_owned);
    http.write(conn_owned, 200, "ok");
    return 0;
}

fn route_users() -> i32 {
    let conn_owned: HttpHandle = http.accept();
    timeout(1000);
    http.read(conn_owned);
    let body = http.body_json(conn_owned);
    let user = json.get_str(body, "user");
    let payload = map.new();
    discard map.set(payload, "ok", "true");
    discard map.set(payload, "user", json.str(user));
    http.write_json(conn_owned, 200, json.object(payload));
    cancel();
    return 0;
}
