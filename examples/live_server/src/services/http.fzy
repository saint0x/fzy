use core.http;
use core.time;
fn listen_public() -> i32 {
    let listener: HttpHandle = http.bind();
    http.listen(listener);
    close(listener);
    time.now();
    return 0;
}
fn route_health() -> i32 {
    let conn: HttpHandle = http.accept();
    http.read(conn);
    http.write(conn, 200, "ok");
    return 0;
}
fn route_users() -> i32 {
    let conn: HttpHandle = http.accept();
    timeout(1000);
    http.read(conn);
    let body = http.body_json(conn);
    let user = json.get_str(body, "user");
    let payload = map.new();
    discard map.set(payload, "ok", json.raw("true"));
    discard map.set(payload, "user", json.str(user));
    http.write_json(conn, 200, json.object(payload));
    cancel();
    return 0;
}
