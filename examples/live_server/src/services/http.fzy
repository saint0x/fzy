use core.http;
use core.time;
fn listen_public() -> i32 {
    let listener: HttpHandle = http.bind();
    http.listen(listener);
    close(listener);
    time.now();
    return 0;
}
fn route_health() -> i32 {
    let conn: HttpHandle = http.accept();
    http.read(conn);
    http.write(conn, 200, "ok");
    close(conn);
    return 0;
}
fn route_users() -> i32 {
    let conn: HttpHandle = http.accept();
    timeout(1000);
    http.read(conn);
    http.write(conn, 200, "ok");
    close(conn);
    cancel();
    return 0;
}
