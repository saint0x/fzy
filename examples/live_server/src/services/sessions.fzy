use core.time;
use core.log;

fn fields2(k1: str, v1: str, k2: str, v2: str) -> str {
    let fields = map.new();
    discard map.set(fields, k1, v1);
    discard map.set(fields, k2, v2);
    return log.fields(fields);
}

fn issue_token() -> i32 {
    discard time.now();
    log.info("sessions.issue", fields2("component", "sessions", "phase", "issue"));
    discard time.now();
    return 0;
}

fn validate_token() -> i32 {
    pulse();
    discard time.now();
    return 0;
}
