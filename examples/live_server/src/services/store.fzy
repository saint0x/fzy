use core.fs;
use core.mem;

fn read_user() -> i32 {
    let store_file_ref = fs.open();
    discard store_file_ref;
    fs.flush();
    fs.read();
    return 0;
}

fn write_user() -> i32 {
    let store_file_ref = fs.open();
    discard store_file_ref;
    fs.flush();
    fs.atomic_write();
    fs.rename_atomic();
    fs.flush();
    fs.fsync();
    fs.write();
    return 0;
}
