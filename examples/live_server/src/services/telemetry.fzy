use core.fs;
use core.time;
use core.proc;
use core.log;

fn fields2(k1: str, v1: str, k2: str, v2: str) -> str {
    let fields = map.new();
    discard map.set(fields, k1, v1);
    discard map.set(fields, k2, v2);
    return log.fields(fields);
}

fn bootstrap_metrics() -> i32 {
    let telemetry_file_ref = fs.open();
    discard telemetry_file_ref;
    log.info("telemetry.bootstrap", fields2("component", "telemetry", "phase", "bootstrap"));
    fs.write();
    discard time.now();
    return 0;
}

fn log_latency_bucket() -> i32 {
    let telemetry_file_ref = fs.open();
    discard telemetry_file_ref;
    log.info("telemetry.latency", fields2("component", "telemetry", "phase", "latency"));
    discard time.now();
    fs.write();
    return 0;
}

fn log_perf_snapshot() -> i32 {
    let telemetry_file_ref = fs.open();
    discard telemetry_file_ref;
    let perf_proc_owned = proc.spawn("echo telemetry-perf");
    defer proc.close(perf_proc_owned);
    discard proc.exec_timeout(perf_proc_owned);
    log.info("telemetry.perf", fields2("component", "telemetry", "phase", "perf"));
    discard time.now();
    return 0;
}

fn flush_runtime_stats() -> i32 {
    let telemetry_file_ref = fs.open();
    discard telemetry_file_ref;
    log.info("telemetry.flush", fields2("component", "telemetry", "phase", "flush"));
    fs.write();
    fs.flush();
    fs.fsync();
    return 0;
}
