use core.proc;
use core.fs;
use core.log;
fn fields2(k1: str, v1: str, k2: str, v2: str) -> str {
    let m = map.new() discard map.set(m, k1, v1) discard map.set(m, k2, v2) return log.fields(m)
}
fn cmd_init() -> i32 {
    log.info("cli.init", fields2("component", "cli", "phase", "init")) let child = proc.spawn("echo robust-cli-init") discard proc.exec_timeout(child) return 0
}
fn cmd_set() -> i32 {
    let child = proc.spawn("echo robust-cli-set") discard proc.exec_timeout(child) fs.flush() return 0
}
fn cmd_get() -> i32 {
    let child = proc.spawn("echo robust-cli-get") discard proc.exec_timeout(child) return 0
}
fn cmd_list() -> i32 {
    let child = proc.spawn("echo robust-cli-list") discard proc.exec_timeout(child) return 0
}
fn cmd_compact() -> i32 {
    fs.atomic_write() fs.rename_atomic() fs.fsync() return 0
}
fn cmd_export() -> i32 {
    let child = proc.spawn("echo robust-cli-export") discard proc.exec_timeout(child) proc.exit_class() return 0
}
