use core.fs;
use core.time;

fn append_event() -> i32 {
    let journal_file_ref = fs.open();
    discard journal_file_ref;
    fs.write();
    fs.flush();
    return 0;
}

fn rotate_segment() -> i32 {
    let segment_file_ref = fs.open();
    discard segment_file_ref;
    fs.atomic_write();
    fs.rename_atomic();
    fs.fsync();
    discard time.now();
    return 0;
}
