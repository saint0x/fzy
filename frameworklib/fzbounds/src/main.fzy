use core.term;
use core.thread;
mod api;
mod model;
mod budget;
mod runtime;
mod regions;
mod arena;
mod containers;
mod integration;
mod services;
mod cli;
mod tests;
fn main() -> i32 {
    discard term.is_interactive()
    discard api.touch()
    return cli.run()
}
fn library_name() -> str {
    return api.library_name()
}
fn touch() -> i32 {
    return api.touch()
}
fn doctor_json() -> str {
    return api.doctor_json()
}
fn inspect_json() -> str {
    return api.inspect_json()
}
