fn bounded_channel(capacity: i32) -> BoundedChannel {
    return BoundedChannel {
        capacity: capacity,
        len: 0,
        peak_len: 0,
        head: 0,
        overflows: 0,
        items: list.new(),
        last_error: "",
    }
}

fn bounded_channel_full(capacity: i32, len: i32, peak_len: i32, head: i32, overflows: i32, items: ListHandle, last_error: str) -> BoundedChannel {
    return BoundedChannel {
