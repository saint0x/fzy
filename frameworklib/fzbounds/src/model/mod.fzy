}

fn runtime_json(state: RuntimeState) -> str {
    let payload = map.new()
    discard map.set(payload, "mode", json.str(state.mode))
    discard map.set(payload, "frozen", json_bool(state.frozen))
    discard map.set(payload, "max_memory_bytes", json_i32(state.max_memory_bytes))
    discard map.set(payload, "memory_used", json_i32(state.memory_used))
    discard map.set(payload, "memory_peak", json_i32(state.memory_peak))
    discard map.set(payload, "allocations_total", json_i32(state.allocations_total))
    discard map.set(payload, "overflows_total", json_i32(state.overflows_total))
    discard map.set(payload, "rejected_total", json_i32(state.rejected_total))
    discard map.set(payload, "region_count", json_i32(state.region_count))
    discard map.set(payload, "region_peak", json_i32(state.region_peak))
    discard map.set(payload, "assert_failures_total", json_i32(state.assert_failures_total))
    discard map.set(payload, "budget", budget_json(state.budget))
    discard map.set(payload, "closed_regions", json.array(state.closed_regions))
    discard map.set(payload, "overflow_events", json.array(state.overflow_events))
    discard map.set(payload, "audit_events", json.array(state.audit_events))
    return json.object(payload)
}
