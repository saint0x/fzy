fn bounded_buffer(capacity_bytes: i32) -> BoundedBuffer {
    return BoundedBuffer {
        capacity_bytes: capacity_bytes,
        used_bytes: 0,
        peak_bytes: 0,
        overflows: 0,
        data: "",
        last_error: "",
    }
}

fn bounded_buffer_full(capacity_bytes: i32, used_bytes: i32, peak_bytes: i32, overflows: i32, data: str, last_error: str) -> BoundedBuffer {
    return BoundedBuffer {
        capacity_bytes: capacity_bytes,
        used_bytes: used_bytes,
        peak_bytes: peak_bytes,
        overflows: overflows,
        data: data,
        last_error: last_error,
    }
}

fn bool_json(v: i32) -> str {
    if v == 1 {
        return "true"
    }
    return "false"
}

fn json_i32(value: i32) -> str {
    return str.from_i32(value)
}

fn json_bool(value: i32) -> str {
    return bool_json(value)
}

fn budget_json(budget: Budget) -> str {
    let payload = map.new()
    discard map.set(payload, "max_memory_bytes", json_i32(budget.max_memory_bytes))
    discard map.set(payload, "max_regions", json_i32(budget.max_regions))
    discard map.set(payload, "max_tasks", json_i32(budget.max_tasks))
    discard map.set(payload, "max_sockets", json_i32(budget.max_sockets))
    discard map.set(payload, "max_buffers", json_i32(budget.max_buffers))
    discard map.set(payload, "max_channels", json_i32(budget.max_channels))
    discard map.set(payload, "max_queue_entries", json_i32(budget.max_queue_entries))
    discard map.set(payload, "max_maps", json_i32(budget.max_maps))
    discard map.set(payload, "max_lists", json_i32(budget.max_lists))
    discard map.set(payload, "max_strings", json_i32(budget.max_strings))
    return json.object(payload)
}

fn overflow_json(event: OverflowEvent) -> str {
    let payload = map.new()
    discard map.set(payload, "resource", json.str(event.resource))
    discard map.set(payload, "capacity", json_i32(event.capacity))
    discard map.set(payload, "attempt", json_i32(event.attempt))
    discard map.set(payload, "region", json.str(event.region))
    discard map.set(payload, "message", json.str(event.message))
    discard map.set(payload, "timestamp_ms", json_i32(event.timestamp_ms))
    discard map.set(payload, "rejected", json_bool(event.rejected))
    return json.object(payload)
}

fn region_json(item: Region) -> str {
    let payload = map.new()
    discard map.set(payload, "name", json.str(item.name))
    discard map.set(payload, "budget_bytes", json_i32(item.budget_bytes))
    discard map.set(payload, "used_bytes", json_i32(item.used_bytes))
    discard map.set(payload, "peak_bytes", json_i32(item.peak_bytes))
    discard map.set(payload, "overflows", json_i32(item.overflows))
    discard map.set(payload, "allocation_count", json_i32(item.allocation_count))
    discard map.set(payload, "started_ms", json_i32(item.started_ms))
    discard map.set(payload, "ended_ms", json_i32(item.ended_ms))
    discard map.set(payload, "closed", json_bool(item.closed))
    return json.object(payload)
}

fn arena_json(item: Arena) -> str {
    let payload = map.new()
    discard map.set(payload, "capacity_bytes", json_i32(item.capacity_bytes))
    discard map.set(payload, "used_bytes", json_i32(item.used_bytes))
    discard map.set(payload, "peak_bytes", json_i32(item.peak_bytes))
    discard map.set(payload, "allocations", json_i32(item.allocations))
    discard map.set(payload, "resets", json_i32(item.resets))
    discard map.set(payload, "overflows", json_i32(item.overflows))
    discard map.set(payload, "last_error", json.str(item.last_error))
    return json.object(payload)
}

fn bounded_list_json(item: BoundedList) -> str {
    let payload = map.new()
    discard map.set(payload, "capacity", json_i32(item.capacity))
    discard map.set(payload, "len", json_i32(item.len))
    discard map.set(payload, "peak_len", json_i32(item.peak_len))
