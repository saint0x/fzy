}

fn bounded_buffer_json(item: BoundedBuffer) -> str {
    let payload = map.new()
    discard map.set(payload, "capacity_bytes", json_i32(item.capacity_bytes))
    discard map.set(payload, "used_bytes", json_i32(item.used_bytes))
    discard map.set(payload, "peak_bytes", json_i32(item.peak_bytes))
    discard map.set(payload, "overflows", json_i32(item.overflows))
    discard map.set(payload, "last_error", json.str(item.last_error))
    discard map.set(payload, "data", json.str(item.data))
