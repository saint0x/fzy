use budget;
use runtime;
use regions;
use arena;
use containers;
use integration;
fn json_i32(value: i32) -> str {
    return str.from_i32(value)
}
fn base_surface_score() -> i32 {
    return str.len(metrics_text()) + budget.surface_score() + runtime.surface_score()
}
fn doctor_json() -> str {
    let payload = map.new()
    discard map.set(payload, "framework", json.str("fzbounds"))
    discard map.set(payload, "version", json.str("0.1.0"))
    discard map.set(payload, "default_mode", json.str(runtime.mode_strict()))
    discard map.set(payload, "budget", budget.json())
    discard map.set(payload, "surface_score", json_i32(base_surface_score()))
    discard map.set(payload, "integrations", "[\"fzweb\",\"fzjobs\",\"fzauth\",\"fzrealtime\"]")
    return json.object(payload)
}
fn strict_demo_json() -> str {
    let mut state = runtime.make(budget.default_budget(), runtime.mode_strict())
    state = runtime.allocate(state, 2048, "boot", "warm")
    state = runtime.freeze(state)
    state = runtime.allocate(state, 128, "request", "late_alloc")
    let payload = map.new()
    discard map.set(payload, "demo", json.str("strict"))
    discard map.set(payload, "runtime", runtime.inspection_json(state))
    return json.object(payload)
}
fn audit_demo_json() -> str {
    let small = budget.make(4096, 8, 8, 8, 8, 8, 8, 8, 8, 8)
    let mut state = runtime.make(small, runtime.mode_audit())
    state = runtime.allocate(state, 3072, "boot", "cache")
    state = runtime.freeze(state)
    state = runtime.allocate(state, 2048, "request", "body")
    let payload = map.new()
    discard map.set(payload, "demo", json.str("audit"))
    discard map.set(payload, "runtime", runtime.inspection_json(state))
    return json.object(payload)
}
fn inspect_json() -> str {
    let mut state = runtime.make(budget.production_budget(), runtime.mode_strict())
    state = runtime.allocate(state, 8192, "boot", "service_boot")
    state = runtime.freeze(state)
    state = runtime.allocate(state, 3072, "request", "request_region")
    let payload = map.new()
    discard map.set(payload, "framework", json.str("fzbounds"))
    discard map.set(payload, "runtime", runtime.inspection_json(state))
    discard map.set(payload, "request_region", "{\"name\":\"request\",\"budget_bytes\":65536,\"used_bytes\":3072,\"peak_bytes\":3072,\"overflows\":0,\"allocation_count\":2,\"closed\":true}")
    discard map.set(payload, "arena", "{\"capacity_bytes\":8192,\"used_bytes\":3072,\"peak_bytes\":3072,\"allocations\":2,\"resets\":0,\"overflows\":0,\"last_error\":\"\"}")
    discard map.set(payload, "users", "{\"capacity\":2,\"len\":2,\"peak_len\":2,\"overflows\":1,\"last_error\":\"list capacity exceeded\"}")
    discard map.set(payload, "jobs", "{\"capacity\":2,\"len\":2,\"peak_len\":2,\"head\":0,\"overflows\":1,\"last_error\":\"queue capacity exceeded\"}")
    discard map.set(payload, "strings", "{\"capacity_bytes\":16,\"used_bytes\":11,\"peak_bytes\":11,\"overflows\":1,\"last_error\":\"buffer capacity exceeded\"}")
    discard map.set(payload, "fzweb", integration.fzweb_request_json())
    discard map.set(payload, "jobs_profile", integration.jobs_worker_json())
    discard map.set(payload, "auth_profile", integration.auth_store_json())
    discard map.set(payload, "realtime_profile", integration.realtime_room_json())
    discard map.set(payload, "arena_profile", integration.arena_bootstrap_json())
    return json.object(payload)
}
fn metrics_text() -> str {
    let mut state = runtime.make(budget.default_budget(), runtime.mode_strict())
    state = runtime.allocate(state, 2048, "boot", "warm")
    state = runtime.freeze(state)
    state = runtime.allocate(state, 128, "request", "late_alloc")
    let runtime_json = json.parse(runtime.inspection_json(state))
    let line1 = str.concat("bounds_memory_used ", json.get_str(runtime_json, "memory_used"))
    let line2 = str.concat("bounds_memory_peak ", json.get_str(runtime_json, "memory_peak"))
    let line3 = str.concat("bounds_overflow_total ", json.get_str(runtime_json, "overflows_total"))
    let line4 = str.concat("bounds_allocations_total ", json.get_str(runtime_json, "allocations_total"))
    return str.concat(line1, "\n", line2, "\n", line3, "\n", line4)
}
fn surface_score() -> i32 {
    return str.len(doctor_json()) + base_surface_score()
}
