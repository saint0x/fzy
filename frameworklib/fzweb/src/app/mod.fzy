use core.http;

use request;

struct App {
    service_name: str,
    service_version: str,
    store_path: str,
    session_secret: str,
    routes: ListHandle,
    middleware: ListHandle,
}

struct RouteDecision {
    handler: str,
    method_allowed: i32,
    public_route: i32,
    skip_rate: i32,
    require_json: i32,
}

fn make(service_name: str, service_version: str, store_path: str, session_secret: str) -> App {
    return App {
        service_name: service_name,
        service_version: service_version,
        store_path: store_path,
        session_secret: session_secret,
        routes: list.new(),
        middleware: list.new(),
    }
}

fn route_spec(method: str, path: str, handler: str, public_route: i32, skip_rate: i32, require_json: i32) -> str {
    return str.concat(
        method,
        "\t",
        path,
        "\t",
        handler,
        "\t",
        str.from_i32(public_route),
        "\t",
        str.from_i32(skip_rate),
        "\t",
        str.from_i32(require_json),
    )
}

fn split_field(spec: str, index: i32) -> str {
    let mut field = 0
    let mut start = 0
    let mut idx = 0
    while idx < str.len(spec) {
        if str.slice(spec, idx, idx + 1) == "\t" {
            if field == index {
                return str.slice(spec, start, idx)
            }
            field += 1
            start = idx + 1
        }
        idx += 1
    }
    if field == index {
        return str.slice(spec, start, str.len(spec))
    }
    return ""
}

fn route_method(spec: str) -> str { return split_field(spec, 0) }
fn route_path(spec: str) -> str { return split_field(spec, 1) }
fn route_handler(spec: str) -> str { return split_field(spec, 2) }
fn route_public(spec: str) -> i32 { return request.parse_i32(split_field(spec, 3)) }
fn route_skip_rate(spec: str) -> i32 { return request.parse_i32(split_field(spec, 4)) }
fn route_require_json(spec: str) -> i32 { return request.parse_i32(split_field(spec, 5)) }

fn add_route(app: App, method: str, path: str, handler: str, public_route: i32, skip_rate: i32, require_json: i32) -> App {
    discard list.push(app.routes, route_spec(method, path, handler, public_route, skip_rate, require_json))
    return app
}

fn use_middleware(app: App, name: str) -> App {
    discard list.push(app.middleware, name)
    return app
}

fn has_middleware(app: App, name: str) -> i32 {
    let mut idx = 0
    while idx < list.len(app.middleware) {
        if list.get(app.middleware, idx) == name {
            return 1
        }
        idx += 1
    }
    return 0
}

fn route_count(app: App) -> i32 {
    return list.len(app.routes)
}

fn decision(handler: str, method_allowed: i32, public_route: i32, skip_rate: i32, require_json: i32) -> RouteDecision {
    return RouteDecision {
        handler: handler,
        method_allowed: method_allowed,
        public_route: public_route,
        skip_rate: skip_rate,
        require_json: require_json,
    }
}

fn not_found() -> RouteDecision {
    return decision("not_found", 1, 0, 0, 0)
}

fn select(app: App, conn: HttpHandle) -> RouteDecision {
    let mut idx = 0
    while idx < list.len(app.routes) {
        let spec = list.get(app.routes, idx)
        let method = route_method(spec)
        let path = route_path(spec)
        if route.match(conn, method, path) == 1 {
            return decision(
                route_handler(spec),
                1,
                route_public(spec),
                route_skip_rate(spec),
                route_require_json(spec),
            )
        }
        idx += 1
    }

    idx = 0
    while idx < list.len(app.routes) {
        let spec = list.get(app.routes, idx)
        let path = route_path(spec)
        if route.match(conn, "", path) == 1 {
            return decision(
                route_handler(spec),
                0,
                route_public(spec),
                route_skip_rate(spec),
                route_require_json(spec),
            )
        }
        idx += 1
    }
    return not_found()
}

fn openapi_json(app: App) -> str {
    let routes = list.new()
    let mut idx = 0
    while idx < list.len(app.routes) {
        let spec = list.get(app.routes, idx)
        let public_json = if route_public(spec) == 1 { "true" } else { "false" }
        let require_json = if route_require_json(spec) == 1 { "true" } else { "false" }
        discard list.push(
            routes,
            str.concat(
                "{\"method\":\"",
                route_method(spec),
                "\",\"path\":\"",
                route_path(spec),
                "\",\"handler\":\"",
                route_handler(spec),
                "\",\"public\":",
                public_json,
                ",\"json_body\":",
                require_json,
                "}",
            ),
        )
        idx += 1
    }
    let info = map.new()
    discard map.set(info, "title", json.str(app.service_name))
    discard map.set(info, "version", json.str(app.service_version))
    let root = map.new()
    discard map.set(root, "openapi", json.str("3.1.0"))
    discard map.set(root, "framework", json.str("fzweb"))
    discard map.set(root, "info", json.object(info))
    discard map.set(root, "routes", json.array(routes))
    return json.object(root)
}
