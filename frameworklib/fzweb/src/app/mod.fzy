use core.http;
use request;
struct App {
    service_name: str,
    service_version: str,
    store_path: str,
    session_secret: str,
    routes: ListHandle,
    middleware: ListHandle,
}
struct Route {
    route_id: i32,
    name: str,
    method: str,
    path: str,
    group: str,
    public_route: i32,
    skip_rate: i32,
    require_json: i32,
}
struct RouteDecision {
    route_id: i32,
    route_name: str,
    route_path: str,
    route_group: str,
    method_allowed: i32,
    public_route: i32,
    skip_rate: i32,
    require_json: i32,
}
fn route_root_id() -> i32 {
    return 1
}
fn route_healthz_id() -> i32 {
    return 2
}
fn route_readyz_id() -> i32 {
    return 3
}
fn route_metrics_id() -> i32 {
    return 4
}
fn route_inspect_id() -> i32 {
    return 5
}
fn route_search_id() -> i32 {
    return 6
}
fn route_echo_post_id() -> i32 {
    return 7
}
fn route_echo_name_id() -> i32 {
    return 8
}
fn route_bind_id() -> i32 {
    return 9
}
fn route_openapi_id() -> i32 {
    return 10
}
fn route_static_id() -> i32 {
    return 11
}
fn route_items_list_id() -> i32 {
    return 12
}
fn route_item_get_id() -> i32 {
    return 13
}
fn route_item_put_id() -> i32 {
    return 14
}
fn route_item_patch_id() -> i32 {
    return 15
}
fn route_item_delete_id() -> i32 {
    return 16
}
fn route_version_id() -> i32 {
    return 17
}
fn route_cookie_set_id() -> i32 {
    return 18
}
fn route_session_login_id() -> i32 {
    return 19
}
fn route_session_me_id() -> i32 {
    return 20
}
fn route_upload_multipart_id() -> i32 {
    return 21
}
fn route_events_id() -> i32 {
    return 22
}
fn route_ws_echo_id() -> i32 {
    return 23
}
fn route_not_found_id() -> i32 {
    return 404
}
fn make(service_name: str, service_version: str, store_path: str, session_secret: str) -> App {
    return App {
        service_name: service_name,
        service_version: service_version,
        store_path: store_path,
        session_secret: session_secret,
        routes: list.new(),
        middleware: list.new(),
    }
}
fn route(route_id: i32, name: str, method: str, path: str, group: str, public_route: i32, skip_rate: i32, require_json: i32,) -> Route {
    return Route {
        route_id: route_id,
        name: name,
        method: method,
        path: path,
        group: group,
        public_route: public_route,
        skip_rate: skip_rate,
        require_json: require_json,
    }
}

fn route_frame_push(wire: str, value: str) -> str {
    return str.concat(str.concat(str.concat(wire, str.from_i32(str.len(value))), "#"), value)
}

fn route_frame_sep(wire: str, start: i32) -> i32 {
    let mut idx = start
    while idx < str.len(wire) {
        if str.slice(wire, idx, idx + 1) == "#" {
            return idx
        }
        idx += 1
    }
    return -1
}

fn route_frame_value_at(wire: str, position: i32) -> str {
    let mut current = 0
    let mut idx = 0
    while idx < str.len(wire) {
        let sep = route_frame_sep(wire, idx)
        if sep < 0 {
            return ""
        }
        let size = request.parse_i32(str.slice(wire, idx, sep))
        let start = sep + 1
        let end = start + size
        if current == position {
            return str.slice(wire, start, end)
        }
        idx = end
        current += 1
    }
    return ""
}

fn route_wire(item: Route) -> str {
    let mut wire = ""
    wire = route_frame_push(wire, str.from_i32(item.route_id))
    wire = route_frame_push(wire, item.name)
    wire = route_frame_push(wire, item.method)
    wire = route_frame_push(wire, item.path)
    wire = route_frame_push(wire, item.group)
    wire = route_frame_push(wire, str.from_i32(item.public_route))
    wire = route_frame_push(wire, str.from_i32(item.skip_rate))
    wire = route_frame_push(wire, str.from_i32(item.require_json))
    return wire
}

fn route_from_wire(raw: str) -> Route {
    return route(
        request.parse_i32(route_frame_value_at(raw, 0)),
        route_frame_value_at(raw, 1),
        route_frame_value_at(raw, 2),
        route_frame_value_at(raw, 3),
        route_frame_value_at(raw, 4),
        request.parse_i32(route_frame_value_at(raw, 5)),
        request.parse_i32(route_frame_value_at(raw, 6)),
        request.parse_i32(route_frame_value_at(raw, 7)),
    )
}
fn route_decision(item: Route, method_allowed: i32) -> RouteDecision {
    return RouteDecision {
        route_id: item.route_id,
        route_name: item.name,
        route_path: item.path,
        route_group: item.group,
        method_allowed: method_allowed,
        public_route: item.public_route,
        skip_rate: item.skip_rate,
        require_json: item.require_json,
    }
}
fn not_found() -> RouteDecision {
    return RouteDecision {
        route_id: route_not_found_id(),
        route_name: "not_found",
        route_path: "",
        route_group: "",
        method_allowed: 1,
        public_route: 0,
        skip_rate: 0,
        require_json: 0,
    }
}
fn add_route(app: App, item: Route) -> App {
    discard list.push(app.routes, route_wire(item))
    return app
}
fn use_middleware(app: App, name: str) -> App {
    discard list.push(app.middleware, name)
    return app
}
fn has_middleware(app: App, name: str) -> i32 {
    let mut idx = 0
    while idx<list.len(app.middleware) {
        if list.get(app.middleware, idx) == name {
            return 1
        }
        idx +=  1
    }
    return 0
}
fn route_count(app: App) -> i32 {
    return list.len(app.routes)
}
fn route_at(app: App, index: i32) -> Route {
    return route_from_wire(list.get(app.routes, index))
}
fn select(app: App, conn: HttpHandle) -> RouteDecision {
    let mut idx = 0
    while idx<list.len(app.routes) {
        let item = route_at(app, idx)
        if route.match (conn, item.method, item.path) == 1 {
            return route_decision(item, 1)
        }
        idx +=  1
    }
    idx = 0
    while idx<list.len(app.routes) {
        let item = route_at(app, idx)
        if route.match (conn, "", item.path) == 1 {
            return route_decision(item, 0)
        }
        idx +=  1
    }
    return not_found()
}
fn route_name(route_id: i32) -> str {
    if route_id == route_root_id() {
        return "root"
    }
    if route_id == route_healthz_id() {
        return "healthz"
    }
    if route_id == route_readyz_id() {
        return "readyz"
    }
    if route_id == route_metrics_id() {
        return "metrics"
    }
    if route_id == route_inspect_id() {
        return "inspect"
    }
    if route_id == route_search_id() {
        return "search"
    }
    if route_id == route_echo_post_id() {
        return "echo_post"
    }
    if route_id == route_echo_name_id() {
        return "echo_name"
    }
    if route_id == route_bind_id() {
        return "bind"
    }
    if route_id == route_openapi_id() {
        return "openapi"
    }
    if route_id == route_static_id() {
        return "static"
    }
    if route_id == route_items_list_id() {
        return "items_list"
    }
    if route_id == route_item_get_id() {
        return "item_get"
    }
    if route_id == route_item_put_id() {
        return "item_put"
    }
    if route_id == route_item_patch_id() {
        return "item_patch"
    }
    if route_id == route_item_delete_id() {
        return "item_delete"
    }
    if route_id == route_version_id() {
        return "version"
    }
    if route_id == route_cookie_set_id() {
        return "cookie_set"
    }
    if route_id == route_session_login_id() {
        return "session_login"
    }
    if route_id == route_session_me_id() {
        return "session_me"
    }
    if route_id == route_upload_multipart_id() {
        return "upload_multipart"
    }
    if route_id == route_events_id() {
        return "events"
    }
    if route_id == route_ws_echo_id() {
        return "ws_echo"
    }
    return "not_found"
}
fn route_group(route_id: i32) -> str {
    if route_id == route_echo_name_id() {
        return "/v1"
    }
    if route_id == route_items_list_id() {
        return "/v1"
    }
    if route_id == route_item_get_id() {
        return "/v1"
    }
    if route_id == route_item_put_id() {
        return "/v1"
    }
    if route_id == route_item_patch_id() {
        return "/v1"
    }
    if route_id == route_item_delete_id() {
        return "/v1"
    }
    if route_id == route_session_login_id() {
        return "/session"
    }
    if route_id == route_session_me_id() {
        return "/session"
    }
    if route_id == route_cookie_set_id() {
        return "/cookies"
    }
    return "/"
}
fn openapi_json(app: App) -> str {
    let routes = list.new()
    let mut idx = 0
    while idx<list.len(app.routes) {
        let item = route_at(app, idx)
        let route_json = map.new()
        discard map.set(route_json, "route_id", json.str(str.from_i32(item.route_id)))
        discard map.set(route_json, "name", json.str(item.name))
        discard map.set(route_json, "method", json.str(item.method))
        discard map.set(route_json, "path", json.str(item.path))
        discard map.set(route_json, "group", json.str(item.group))
        discard map.set(route_json, "public", json.str(if item.public_route == 1 {
            "true"
        } else {
            "false"
        }
        ))
        discard map.set(route_json, "json_body", json.str(if item.require_json == 1 {
            "true"
        } else {
            "false"
        }
        ))
        discard map.set(route_json, "rate_limited", json.str(if item.skip_rate == 1 {
            "false"
        } else {
            "true"
        }
        ))
        discard list.push(routes, json.object(route_json))
        idx +=  1
    }
    let info = map.new()
    discard map.set(info, "title", json.str(app.service_name))
    discard map.set(info, "version", json.str(app.service_version))
    let root = map.new()
    discard map.set(root, "openapi", json.str("3.1.0"))
    discard map.set(root, "framework", json.str("fzweb"))
    discard map.set(root, "info", json.object(info))
    discard map.set(root, "routes", json.array(routes))
    return json.object(root)
}
