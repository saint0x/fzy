use core.thread;

mod webcore;
mod middleware;
mod support;
mod request;
mod response;
mod routing;

fn surface_score() -> i32 {
    let cfg = support.server_config()
    let policy = support.policy_from_config(cfg)
    let boot_rate = middleware.rate_init(policy, 0)
    let warm_rate = middleware.rate_refill(policy, boot_rate, cfg.rate_refill_ms * 3)
    let limited_rate = middleware.rate_take(warm_rate, 2)
    let metrics0 = support.metrics_new()
    let metrics1 = support.metrics_record(metrics0, 200)
    let metrics2 = support.metrics_record(metrics1, 401)
    let metrics3 = support.metrics_record(metrics2, 429)
    let openapi = routing.openapi_json()
    let status = response.ok_json("boot", "req-det")
    let route = support.route_kernel_score("GET", "/static/app.js")
    let static_name = support.safe_static_name("../blocked")
    let text = support.metrics_text(metrics3, 0)

    return (
        cfg.timeout_ms
        + cfg.max_body_bytes
        + boot_rate.tokens
        + warm_rate.tokens
        + limited_rate.tokens
        + str.len(openapi)
        + str.len(status)
        + route
        + str.len(static_name)
        + str.len(text)
    ) % 251
}

test "det_surface_score" {
    let score = surface_score()
    if score >= 0 {
        checkpoint()
    }
}

test "det_policy_and_rate" {
    let cfg = support.server_config()
    let policy = support.policy_from_config(cfg)
    let rate0 = middleware.rate_init(policy, 0)
    let rate1 = middleware.rate_refill(policy, rate0, cfg.rate_refill_ms * 5)
    let rate2 = middleware.rate_take(rate1, 3)
    discard rate2
    checkpoint()
}

test "det_docs_and_metrics" {
    let openapi = routing.openapi_json()
    let metrics = support.metrics_record(support.metrics_new(), 200)
    let rendered = support.metrics_text(metrics, 0)
    if str.contains(openapi, "/openapi.json") == 1 && str.contains(rendered, "fzweb_requests_total") == 1 {
        checkpoint()
    }
}

test "det_routing_and_response_surface" {
    let catalog = routing.openapi_json()
    let inspect = response.inspect_json("req-1", "GET", "/inspect", "127.0.0.1", "application/json", "", "inspect")
    let item = response.item_json("updated", "abc", 7, "req-2")
    if str.contains(catalog, "/v1/items/:id") == 1 && str.contains(inspect, "\"route\":\"inspect\"") == 1 && str.contains(item, "\"version\":\"7\"") == 1 {
        checkpoint()
    }
}

fn main() -> i32 {
    return surface_score()
}
