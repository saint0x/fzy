use core.http;
use request;
struct ApiError {
    status: i32,
    code: str,
    message: str,
    details: str,
}
struct ResponsePlan {
    status: i32,
    content_type: str,
    body: str,
    close: i32,
}
fn header_set(conn: HttpHandle, key: str, value: str) -> i32 {
    return http.response_header_set(conn, key, value)
}
fn header_add(conn: HttpHandle, key: str, value: str) -> i32 {
    return http.response_header_add(conn, key, value)
}
fn header_clear(conn: HttpHandle) -> i32 {
    return http.response_header_clear(conn)
}
fn plan(status: i32, content_type: str, body: str) -> ResponsePlan {
    return ResponsePlan {
        status: status,
        content_type: content_type,
        body: body,
        close: 1,
    }
}
fn text(status: i32, body: str) -> ResponsePlan {
    return plan(status, "text/plain; charset=utf-8", body)
}
fn json_plan(status: i32, body: str) -> ResponsePlan {
    return plan(status, "application/json; charset=utf-8", body)
}
fn bytes(status: i32, content_type: str, body: str) -> ResponsePlan {
    return plan(status, content_type, body)
}
fn no_content_plan() -> ResponsePlan {
    return plan(204, "text/plain; charset=utf-8", "")
}
fn accepted_json(body: str) -> ResponsePlan {
    return json_plan(202, body)
}
fn emit(conn: HttpHandle, out: ResponsePlan) -> i32 {
    return http.write_response(conn, out.status, out.content_type, out.body, out.close)
}
fn send_text(conn: HttpHandle, status: i32, body: str) -> i32 {
    return emit(conn, text(status, body))
}
fn send_json(conn: HttpHandle, status: i32, body: str) -> i32 {
    return emit(conn, json_plan(status, body))
}
fn send_bytes(conn: HttpHandle, status: i32, content_type: str, body: str) -> i32 {
    return emit(conn, bytes(status, content_type, body))
}
fn no_content(conn: HttpHandle) -> i32 {
    return emit(conn, no_content_plan())
}
fn api_error(status: i32, code: str, message: str, details: str) -> ApiError {
    return ApiError {
        status: status,
        code: code,
        message: message,
        details: details,
    }
}
fn request_error(err: request.RequestError) -> ApiError {
    return api_error(err.status, err.code, err.message, err.details)
}
fn error_json(code: str, message: str) -> str {
    return error_body(api_error(400, code, message, ""))
}
fn error_body(err: ApiError) -> str {
    let payload = map.new()
    discard map.set(payload, "error", json.str(err.code))
    discard map.set(payload, "message", json.str(err.message))
    if err.details != "" {
        discard map.set(payload, "details", json.str(err.details))
    }
    discard map.set(payload, "framework", json.str("fzweb"))
    return json.object(payload)
}
fn error_plan(err: ApiError) -> ResponsePlan {
    return json_plan(err.status, error_body(err))
}
fn ok_json(event: str, request_id: str) -> str {
    let payload = map.new()
    discard map.set(payload, "status", json.str("ok"))
    discard map.set(payload, "event", json.str(event))
    discard map.set(payload, "request_id", json.str(request_id))
    discard map.set(payload, "framework", json.str("fzweb"))
    return json.object(payload)
}
fn service_json(service_name: str, service_version: str, request_id: str) -> str {
    let payload = map.new()
    discard map.set(payload, "service", json.str(service_name))
    discard map.set(payload, "version", json.str(service_version))
    discard map.set(payload, "status", json.str("ok"))
    discard map.set(payload, "request_id", json.str(request_id))
    return json.object(payload)
}
fn version_json(service_name: str, service_version: str, request_id: str) -> str {
    let payload = map.new()
    discard map.set(payload, "service", json.str(service_name))
    discard map.set(payload, "version", json.str(service_version))
    discard map.set(payload, "framework", json.str("fzweb"))
    discard map.set(payload, "request_id", json.str(request_id))
    return json.object(payload)
}
fn inspect_json(request_id: str, method: str, path: str, remote: str, accept: str, content_type: str, route_name: str,) -> str {
    let payload = map.new()
    discard map.set(payload, "request_id", json.str(request_id))
    discard map.set(payload, "method", json.str(method))
    discard map.set(payload, "path", json.str(path))
    discard map.set(payload, "remote", json.str(remote))
    discard map.set(payload, "accept", json.str(accept))
    discard map.set(payload, "content_type", json.str(content_type))
    discard map.set(payload, "route", json.str(route_name))
    discard map.set(payload, "framework", json.str("fzweb"))
    return json.object(payload)
}
fn search_json(query_text: str, limit: i32, request_id: str) -> str {
    let payload = map.new()
    discard map.set(payload, "query", json.str(query_text))
    discard map.set(payload, "limit", json.str(str.from_i32(limit)))
    discard map.set(payload, "request_id", json.str(request_id))
    return json.object(payload)
}
fn named_echo_json(name: str, request_id: str) -> str {
    let payload = map.new()
    discard map.set(payload, "name", json.str(name))
    discard map.set(payload, "request_id", json.str(request_id))
    return json.object(payload)
}
fn bind_json(user: str, active: i32, request_id: str) -> str {
    let payload = map.new()
    discard map.set(payload, "user", json.str(user))
    discard map.set(payload, "active", json.str(if active == 1 {
        "true"
    } else {
        "false"
    }
    ))
    discard map.set(payload, "request_id", json.str(request_id))
    return json.object(payload)
}
fn item_json(action: str, item_id: str, version: i32, request_id: str) -> str {
    let payload = map.new()
    discard map.set(payload, "action", json.str(action))
    discard map.set(payload, "item_id", json.str(item_id))
    discard map.set(payload, "version", json.str(str.from_i32(version)))
    discard map.set(payload, "framework", json.str("fzweb"))
    discard map.set(payload, "request_id", json.str(request_id))
    return json.object(payload)
}
fn item_view_json(item_id: str, version: i32, exists: i32, request_id: str) -> str {
    let payload = map.new()
    discard map.set(payload, "item_id", json.str(item_id))
    discard map.set(payload, "version", json.str(str.from_i32(version)))
    discard map.set(payload, "exists", json.str(if exists == 1 {
        "true"
    } else {
        "false"
    }
    ))
    discard map.set(payload, "request_id", json.str(request_id))
    return json.object(payload)
}
fn items_json(request_id: str) -> str {
    let items = list.new()
    let alpha = map.new()
    discard map.set(alpha, "item_id", json.str("alpha"))
    discard map.set(alpha, "version", json.str("1"))
    discard list.push(items, json.object(alpha))
    let beta = map.new()
    discard map.set(beta, "item_id", json.str("beta"))
    discard map.set(beta, "version", json.str("2"))
    discard list.push(items, json.object(beta))
    let payload = map.new()
    discard map.set(payload, "count", json.str("2"))
    discard map.set(payload, "items", json.array(items))
    discard map.set(payload, "request_id", json.str(request_id))
    return json.object(payload)
}
