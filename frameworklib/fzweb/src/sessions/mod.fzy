use core.http;
use core.security;
use core.storage;
use core.time;
use cookies;
use persistence;
use request;
struct SessionConfig {
    store_path: str,
    secret: str,
    cookie_name: str,
    ttl_seconds: i32,
}
struct SessionRecord {
    id: str,
    user: str,
    issued_ms: i32,
    expires_ms: i32,
}
fn config(store_path: str, secret: str, cookie_name: str, ttl_seconds: i32) -> SessionConfig {
    return SessionConfig {
        store_path: store_path,
        secret: secret,
        cookie_name: cookie_name,
        ttl_seconds: ttl_seconds,
    }
}
fn record(id: str, user: str, issued_ms: i32, expires_ms: i32) -> SessionRecord {
    return SessionRecord {
        id: id,
        user: user,
        issued_ms: issued_ms,
        expires_ms: expires_ms,
    }
}
fn store(cfg: SessionConfig) -> persistence.Store {
    return persistence.open(cfg.store_path)
}

fn frame_push(wire: str, value: str) -> str {
    return str.concat(str.concat(str.concat(wire, str.from_i32(str.len(value))), "#"), value)
}

fn frame_sep(wire: str, start: i32) -> i32 {
    let mut idx = start
    while idx < str.len(wire) {
        if str.slice(wire, idx, idx + 1) == "#" {
            return idx
        }
        idx += 1
    }
    return -1
}

fn frame_value_at(wire: str, position: i32) -> str {
    let mut current = 0
    let mut idx = 0
    while idx < str.len(wire) {
        let sep = frame_sep(wire, idx)
        if sep < 0 {
            return ""
        }
        let size = request.parse_i32(str.slice(wire, idx, sep))
        let start = sep + 1
        let end = start + size
        if size < 0 || end > str.len(wire) {
            return ""
        }
        if current == position {
            return str.slice(wire, start, end)
        }
        idx = end
        current += 1
    }
    return ""
}

fn encode(rec: SessionRecord) -> str {
    let mut wire = ""
    wire = frame_push(wire, rec.id)
    wire = frame_push(wire, rec.user)
    wire = frame_push(wire, str.from_i32(rec.issued_ms))
    wire = frame_push(wire, str.from_i32(rec.expires_ms))
    return str.concat("v1|", wire)
}

fn decode_legacy_json(raw: str) -> SessionRecord {
    let payload = json.parse(raw)
    return record(
        json.get_str(payload, "id"),
        json.get_str(payload, "user"),
        request.parse_i32(json.get_str(payload, "issued_ms")),
        request.parse_i32(json.get_str(payload, "expires_ms")),
    )
}

fn decode(raw: str) -> SessionRecord {
    if raw == "" {
        return record("", "", 0, 0)
    }
    if str.len(raw) >= 3 && str.slice(raw, 0, 3) == "v1|" {
        let framed = str.slice(raw, 3, str.len(raw))
        return record(
            frame_value_at(framed, 0),
            frame_value_at(framed, 1),
            request.parse_i32(frame_value_at(framed, 2)),
            request.parse_i32(frame_value_at(framed, 3)),
        )
    }
    if str.slice(raw, 0, 1) == "{" {
        return decode_legacy_json(raw)
    }
    return record(
        frame_value_at(raw, 0),
        frame_value_at(raw, 1),
        request.parse_i32(frame_value_at(raw, 2)),
        request.parse_i32(frame_value_at(raw, 3)),
    )
}
fn issue_id() -> str {
    return security.opaque_token(24)
}
fn create(cfg: SessionConfig, user: str) -> SessionRecord {
    let issued = time.monotonic_ms()
    let rec = record(issue_id(), user, issued, issued + (cfg.ttl_seconds * 1000))
    discard persistence.put(store(cfg), "session", rec.id, encode(rec))
    return rec
}
fn load(cfg: SessionConfig, session_id: str) -> SessionRecord {
    return decode(persistence.get(store(cfg), "session", session_id))
}
fn valid(rec: SessionRecord) -> i32 {
    if rec.id == "" || rec.user == "" {
        return 0
    }
    if rec.expires_ms <= time.monotonic_ms() {
        return 0
    }
    return 1
}
fn from_request(conn: HttpHandle, cfg: SessionConfig) -> SessionRecord {
    let raw = cookies.cookie_value(request.header(conn, "cookie"), cfg.cookie_name)
    let session_id = raw
    if session_id == "" {
        return record("", "", 0, 0)
    }
    let rec = load(cfg, session_id)
    if valid(rec) == 1 {
        return rec
    }
    return record("", "", 0, 0)
}
fn attach(conn: HttpHandle, cfg: SessionConfig, rec: SessionRecord) -> i32 {
    return cookies.set_cookie(conn, cfg.cookie_name, rec.id, "/", cfg.ttl_seconds, 1, 1, "Lax",)
}
fn clear(conn: HttpHandle, cfg: SessionConfig) -> i32 {
    return cookies.clear_cookie(conn, cfg.cookie_name, "/")
}
