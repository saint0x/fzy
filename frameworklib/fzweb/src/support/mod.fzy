use core.http;
use core.log;
use core.storage;
use core.time;
use core.thread;

use app;
use cookies;
use middleware;
use multipart;
use persistence;
use request;
use response;
use sessions;
use streaming;
use webcore;

struct ServerConfig {
    service_name: str,
    service_version: str,
    store_path: str,
    session_secret: str,
    timeout_ms: i32,
    max_body_bytes: i32,
    enable_cors: i32,
    enable_request_log: i32,
    require_auth: i32,
    auth_token: str,
    require_json_body: i32,
    enable_rate_limit: i32,
    rate_capacity: i32,
    rate_refill_ms: i32,
    max_requests: i32,
}

struct MetricsState {
    total_requests: i32,
    ok_responses: i32,
    client_errors: i32,
    server_errors: i32,
    unauthorized: i32,
    rate_limited: i32,
}

struct HandleOutcome {
    status: i32,
    rate: middleware.RateState,
    metrics: MetricsState,
}

fn fields2(k1: str, v1: str, k2: str, v2: str) -> str {
    let m = map.new()
    discard map.set(m, k1, v1)
    discard map.set(m, k2, v2)
    return log.fields(m)
}

fn bool_env(key: str, fallback: i32) -> i32 {
    let raw = str.lower_ascii(str.trim(env.get(key)))
    if raw == "" {
        return fallback
    }
    if raw == "1" {
        return 1
    }
    if raw == "true" {
        return 1
    }
    if raw == "yes" {
        return 1
    }
    if raw == "on" {
        return 1
    }
    return 0
}

fn i32_env(key: str, fallback: i32, min_value: i32, max_value: i32) -> i32 {
    let raw = str.trim(env.get(key))
    if raw == "" {
        return fallback
    }
    let mut value = request.parse_i32(raw)
    if value < min_value {
        value = min_value
    }
    if value > max_value {
        value = max_value
    }
    return value
}

fn text_env(key: str, fallback: str) -> str {
    let raw = env.get(key)
    if raw == "" {
        return fallback
    }
    return raw
}

fn server_config() -> ServerConfig {
    return ServerConfig {
        service_name: text_env("FZWEB_SERVICE_NAME", "fzweb"),
        service_version: text_env("FZWEB_SERVICE_VERSION", "dev"),
        store_path: text_env("FZWEB_STORE_PATH", "fzweb.store.kv"),
        session_secret: text_env("FZWEB_SESSION_SECRET", "fzweb-dev-secret"),
        timeout_ms: i32_env("FZWEB_TIMEOUT_MS", 2500, 1, 30000),
        max_body_bytes: i32_env("FZWEB_MAX_BODY_BYTES", 1048576, 64, 16777216),
        enable_cors: bool_env("FZWEB_ENABLE_CORS", 1),
        enable_request_log: bool_env("FZWEB_ENABLE_REQUEST_LOG", 1),
        require_auth: bool_env("FZWEB_REQUIRE_AUTH", 0),
        auth_token: text_env("FZWEB_AUTH_TOKEN", ""),
        require_json_body: bool_env("FZWEB_REQUIRE_JSON_BODY", 1),
        enable_rate_limit: bool_env("FZWEB_ENABLE_RATE_LIMIT", 1),
        rate_capacity: i32_env("FZWEB_RATE_CAPACITY", 120, 1, 100000),
        rate_refill_ms: i32_env("FZWEB_RATE_REFILL_MS", 1000, 1, 600000),
        max_requests: i32_env("FZWEB_MAX_REQUESTS", 2000000000, 1, 2000000000),
    }
}

fn policy_from_config(cfg: ServerConfig) -> middleware.Policy {
    return middleware.policy(
        cfg.timeout_ms,
        cfg.max_body_bytes,
        cfg.require_auth,
        cfg.auth_token,
        cfg.enable_cors,
        cfg.enable_request_log,
        cfg.require_json_body,
        cfg.enable_rate_limit,
        cfg.rate_capacity,
        cfg.rate_refill_ms,
    )
}

fn metrics_new() -> MetricsState {
    return MetricsState {
        total_requests: 0,
        ok_responses: 0,
        client_errors: 0,
        server_errors: 0,
        unauthorized: 0,
        rate_limited: 0,
    }
}

fn metrics_record(metrics: MetricsState, status: i32) -> MetricsState {
    let mut ok = metrics.ok_responses
    let mut client = metrics.client_errors
    let mut server = metrics.server_errors
    let mut unauthorized = metrics.unauthorized
    let mut rate_limited = metrics.rate_limited

    if status >= 200 && status < 300 {
        ok += 1
    }
    if status >= 400 && status < 500 {
        client += 1
    }
    if status >= 500 {
        server += 1
    }
    if status == 401 {
        unauthorized += 1
    }
    if status == 429 {
        rate_limited += 1
    }

    return MetricsState {
        total_requests: metrics.total_requests + 1,
        ok_responses: ok,
        client_errors: client,
        server_errors: server,
        unauthorized: unauthorized,
        rate_limited: rate_limited,
    }
}

fn gate_body(reason: str) -> str {
    return response.error_json(reason, reason)
}

fn safe_static_name(name: str) -> str {
    if name == "" {
        return "index.txt"
    }
    if str.contains(name, "..") == 1 {
        return "blocked.txt"
    }
    if str.contains(name, "/") == 1 {
        return "blocked.txt"
    }
    return name
}

fn static_body(name: str) -> str {
    return str.concat("static asset: ", safe_static_name(name))
}

fn metrics_text(metrics: MetricsState, started_ms: i32) -> str {
    let uptime_ms = time.monotonic_ms() - started_ms
    let line1 = str.concat("fzweb_requests_total ", str.from_i32(metrics.total_requests))
    let line2 = str.concat("fzweb_responses_ok ", str.from_i32(metrics.ok_responses))
    let line3 = str.concat("fzweb_responses_client_error ", str.from_i32(metrics.client_errors))
    let line4 = str.concat("fzweb_responses_server_error ", str.from_i32(metrics.server_errors))
    let line5 = str.concat("fzweb_unauthorized_total ", str.from_i32(metrics.unauthorized))
    let line6 = str.concat("fzweb_rate_limited_total ", str.from_i32(metrics.rate_limited))
    let line7 = str.concat("fzweb_uptime_ms ", str.from_i32(uptime_ms))
    return str.concat(line1, "\n", line2, "\n", line3, "\n", line4, "\n", line5, "\n", line6, "\n", line7)
}

fn route_kernel_score(method: str, path: str) -> i32 {
    let mut score = (str.len(method) * 17) + (str.len(path) * 19)
    if method == "GET" {
        score += 11
    }
    if method == "POST" {
        score += 13
    }
    if path == "/healthz" {
        score += 23
    }
    if str.starts_with(path, "/static/") == 1 {
        score += 29
    }
    return score % 251
}

fn session_config(cfg: ServerConfig) -> sessions.SessionConfig {
    return sessions.config(cfg.store_path, cfg.session_secret, "fzweb_session", 3600)
}

fn default_app(cfg: ServerConfig) -> app.App {
    let mut web = app.make(cfg.service_name, cfg.service_version, cfg.store_path, cfg.session_secret)
    web = app.use_middleware(web, "security_headers")
    web = app.use_middleware(web, "request_log")
    web = app.use_middleware(web, "cors")
    web = app.use_middleware(web, "auth")
    web = app.use_middleware(web, "json")
    web = app.use_middleware(web, "rate_limit")

    web = app.add_route(web, "GET", "/", "root", 1, 1, 0)
    web = app.add_route(web, "GET", "/healthz", "healthz", 1, 1, 0)
    web = app.add_route(web, "GET", "/readyz", "readyz", 1, 1, 0)
    web = app.add_route(web, "GET", "/metrics", "metrics", 1, 1, 0)
    web = app.add_route(web, "GET", "/inspect", "inspect", 0, 0, 0)
    web = app.add_route(web, "GET", "/search", "search", 0, 0, 0)
    web = app.add_route(web, "POST", "/echo", "echo_post", 0, 0, 1)
    web = app.add_route(web, "GET", "/v1/echo/:name", "echo_name", 0, 0, 0)
    web = app.add_route(web, "POST", "/bind", "bind", 0, 0, 1)
    web = app.add_route(web, "GET", "/openapi.json", "openapi", 1, 1, 0)
    web = app.add_route(web, "GET", "/version", "version", 1, 1, 0)
    web = app.add_route(web, "GET", "/static/:name", "static", 0, 0, 0)
    web = app.add_route(web, "GET", "/v1/items", "items_list", 0, 0, 0)
    web = app.add_route(web, "GET", "/v1/items/:id", "item_get", 0, 0, 0)
    web = app.add_route(web, "PUT", "/v1/items/:id", "item_put", 0, 0, 1)
    web = app.add_route(web, "PATCH", "/v1/items/:id", "item_patch", 0, 0, 1)
    web = app.add_route(web, "DELETE", "/v1/items/:id", "item_delete", 0, 0, 0)
    web = app.add_route(web, "GET", "/cookies/set", "cookie_set", 1, 1, 0)
    web = app.add_route(web, "POST", "/session/login", "session_login", 1, 1, 1)
    web = app.add_route(web, "GET", "/session/me", "session_me", 1, 0, 0)
    web = app.add_route(web, "POST", "/upload", "upload_multipart", 0, 0, 0)
    web = app.add_route(web, "GET", "/events", "events", 1, 1, 0)
    web = app.add_route(web, "GET", "/ws", "ws_echo", 1, 1, 0)
    return web
}

fn handle_route(
    conn: HttpHandle,
    web: app.App,
    decision: app.RouteDecision,
    cfg: ServerConfig,
    metrics: MetricsState,
    rate: middleware.RateState,
    started_ms: i32,
) -> HandleOutcome {
    if decision.method_allowed == 0 {
        discard webcore.response_method_not_allowed(conn)
        return HandleOutcome {
            status: 405,
            rate: rate,
            metrics: metrics_record(metrics, 405),
        }
    }

    if app.has_middleware(web, "security_headers") == 1 {
            discard cookies.default_security_headers(conn)
    }

    if decision.handler == "root" {
            discard response.send_json(
                conn,
                200,
                response.service_json(
                    cfg.service_name,
                    cfg.service_version,
                    request.request_id(conn),
                ),
            )
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "healthz" {
            discard response.send_text(conn, 200, "ok")
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "readyz" {
            discard response.send_text(conn, 200, "ready")
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "metrics" {
            discard response.send_bytes(
                conn,
                200,
                "text/plain; version=0.0.4; charset=utf-8",
                metrics_text(metrics, started_ms),
            )
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "inspect" {
            discard response.send_json(
                conn,
                200,
                response.inspect_json(
                    request.request_id(conn),
                    request.method(conn),
                    request.path(conn),
                    request.remote(conn),
                    request.accept(conn),
                    request.content_type(conn),
                    decision.handler,
                ),
            )
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "search" {
            let q = request.query(conn, "q")
            let limit = request.query_i32_default(conn, "limit", 10)
            discard response.send_json(
                conn,
                200,
                response.search_json(q, limit, request.request_id(conn)),
            )
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "echo_post" {
            let mut body = request.body_max(conn, 1048576)
            if body == "" && request.body_eof(conn) == 0 {
                while request.body_eof(conn) == 0 && str.len(body) < 1048576 {
                    body = str.concat(body, request.body_read(conn, 512))
                }
            }
            if body == "" && request.content_type_is_json(conn) == 1 {
                body = json.get_str(request.body_json(conn), "raw")
            }
            discard response.send_json(conn, 200, if body == "" { response.ok_json("echo", request.request_id(conn)) } else { body })
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "echo_name" {
            let name = request.param(conn, "name")
            discard response.send_json(
                conn,
                200,
                response.named_echo_json(name, request.request_id(conn)),
            )
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "bind" {
            let payload = request.body_json(conn)
            discard response.send_json(
                conn,
                200,
                response.bind_json(
                    json.get_str(payload, "user"),
                    request.parse_bool_text(json.get_str(payload, "active")),
                    request.request_id(conn),
                ),
            )
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "openapi" {
            discard response.send_json(conn, 200, app.openapi_json(web))
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "version" {
            discard response.send_json(
                conn,
                200,
                response.version_json(
                    cfg.service_name,
                    cfg.service_version,
                    request.request_id(conn),
                ),
            )
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "static" {
            let name = request.param(conn, "name")
            discard response.send_bytes(
                conn,
                200,
                "text/plain; charset=utf-8",
                static_body(name),
            )
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "items_list" {
            discard response.send_json(
                conn,
                200,
                response.items_json(request.request_id(conn)),
            )
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "item_get" {
            let item_id = request.param(conn, "id")
            let version = request.query_i32_default(conn, "version", 1)
            discard response.send_json(
                conn,
                200,
                response.item_view_json(item_id, version, 1, request.request_id(conn)),
            )
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "item_put" {
            let item_id = request.param(conn, "id")
            let version = request.query_i32_default(conn, "version", 1)
            discard persistence.put_json(
                persistence.open(cfg.store_path),
                "item",
                item_id,
                response.item_json("updated", item_id, version, request.request_id(conn)),
            )
            discard response.send_json(
                conn,
                200,
                response.item_json("updated", item_id, version, request.request_id(conn)),
            )
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "item_patch" {
            let item_id = request.param(conn, "id")
            let version = request.query_i32_default(conn, "version", 1)
            discard response.send_json(
                conn,
                200,
                response.item_json("patched", item_id, version, request.request_id(conn)),
            )
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "item_delete" {
            let item_id = request.param(conn, "id")
            let version = request.query_i32_default(conn, "version", 1)
            discard response.send_json(
                conn,
                202,
                response.item_json("deleted", item_id, version, request.request_id(conn)),
            )
            return HandleOutcome {
                status: 202,
                rate: rate,
                metrics: metrics_record(metrics, 202),
            }
    }
    if decision.handler == "cookie_set" {
            discard cookies.set_cookie(conn, "theme", "light", "/", 86400, 0, 1, "Lax")
            discard response.send_json(conn, 200, response.ok_json("cookie_set", request.request_id(conn)))
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "session_login" {
            let payload = request.body_json(conn)
            let mut user = json.get_str(payload, "user")
            if user == "" {
                user = request.query(conn, "user")
            }
            if user == "" {
                user = "session-user"
            }
            let rec = sessions.create(session_config(cfg), user)
            discard sessions.attach(conn, session_config(cfg), rec)
            discard response.send_json(conn, 200, response.bind_json(rec.user, 1, request.request_id(conn)))
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "session_me" {
            let rec = sessions.from_request(conn, session_config(cfg))
            if sessions.valid(rec) == 0 {
                discard response.send_json(conn, 401, response.error_json("unauthorized", "unauthorized"))
                return HandleOutcome {
                    status: 401,
                    rate: rate,
                    metrics: metrics_record(metrics, 401),
                }
            }
            discard response.send_json(conn, 200, response.bind_json(rec.user, 1, request.request_id(conn)))
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "upload_multipart" {
            let upload = multipart.parse(conn, cfg.max_body_bytes)
            discard response.send_json(conn, 200, multipart.json_summary(upload, request.request_id(conn)))
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "events" {
            discard streaming.send_sse_boot(conn)
            return HandleOutcome {
                status: 200,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }
    if decision.handler == "ws_echo" {
            discard streaming.websocket_echo(conn)
            return HandleOutcome {
                status: 101,
                rate: rate,
                metrics: metrics_record(metrics, 200),
            }
    }

    discard webcore.response_not_found(conn)
    return HandleOutcome {
        status: 404,
        rate: rate,
        metrics: metrics_record(metrics, 404),
    }
}

fn run_live_server() -> i32 {
    discard log.set_json(1)
    let cfg = server_config()
    let web = default_app(cfg)
    let policy = policy_from_config(cfg)
    let listener = http.bind()
    if http.listen(listener) != 0 {
        close(listener)
        return 11
    }

    discard log.info("fzweb.server.start", fields2("component", "fzweb", "mode", "live"))

    let started_ms = time.monotonic_ms()
    let mut handled = 0
    let mut rate = middleware.rate_init(policy, started_ms)
    let mut metrics = metrics_new()

    while handled < cfg.max_requests {
        let conn = http.accept()
        let read_status = webcore.request_read(conn)
        if read_status != 0 {
            discard webcore.response_service_unavailable(conn, "{\"error\":\"read_failed\"}")
            metrics = metrics_record(metrics, 503)
            handled += 1
            continue
        }

        let decision = app.select(web, conn)
        let gate = middleware.before_dispatch(conn, web, decision, policy, rate)
        rate = gate.rate
        if gate.handled == 1 {
            if gate.status == 204 {
                discard response.no_content(conn)
            } else {
                discard response.send_json(conn, gate.status, gate_body(gate.reason))
            }
            metrics = metrics_record(metrics, gate.status)
            handled += 1
            if (handled % 256) == 0 {
                yield()
            }
            continue
        }

        let outcome = handle_route(conn, web, decision, cfg, metrics, rate, started_ms)
        metrics = outcome.metrics
        rate = outcome.rate
        handled += 1
        if (handled % 256) == 0 {
            yield()
        }
    }

    close(listener)
    return 0
}
