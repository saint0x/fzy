use core.http;
use core.log;
use core.time;
use core.thread;

use app;
use cookies;
use middleware;
use multipart;
use persistence;
use request;
use response;
use sessions;
use streaming;
use webcore;

struct ServerConfig {
    service_name: str,
    service_version: str,
    store_path: str,
    session_secret: str,
    timeout_ms: i32,
    max_body_bytes: i32,
    enable_cors: i32,
    enable_request_log: i32,
    require_auth: i32,
    auth_token: str,
    require_json_body: i32,
    enable_rate_limit: i32,
    rate_capacity: i32,
    rate_refill_ms: i32,
    max_requests: i32,
}

struct MetricsState {
    total_requests: i32,
    ok_responses: i32,
    client_errors: i32,
    server_errors: i32,
    unauthorized: i32,
    rate_limited: i32,
}

struct HandleOutcome {
    status: i32,
    rate: middleware.RateState,
    metrics: MetricsState,
}

fn fields2(k1: str, v1: str, k2: str, v2: str) -> str {
    let m = map.new()
    discard map.set(m, k1, v1)
    discard map.set(m, k2, v2)
    return log.fields(m)
}

fn bool_env(key: str, fallback: i32) -> i32 {
    let raw = str.lower_ascii(str.trim(env.get(key)))
    if raw == "" {
        return fallback
    }
    if raw == "1" {
        return 1
    }
    if raw == "true" {
        return 1
    }
    if raw == "yes" {
        return 1
    }
    if raw == "on" {
        return 1
    }
    return 0
}

fn i32_env(key: str, fallback: i32, min_value: i32, max_value: i32) -> i32 {
    let raw = str.trim(env.get(key))
    if raw == "" {
        return fallback
    }
    let mut value = request.parse_i32(raw)
    if value < min_value {
        value = min_value
    }
    if value > max_value {
        value = max_value
    }
    return value
}

fn text_env(key: str, fallback: str) -> str {
    let raw = env.get(key)
    if raw == "" {
        return fallback
    }
    return raw
}

fn server_config() -> ServerConfig {
    return ServerConfig {
        service_name: text_env("FZWEB_SERVICE_NAME", "fzweb"),
        service_version: text_env("FZWEB_SERVICE_VERSION", "dev"),
        store_path: text_env("FZWEB_STORE_PATH", "fzweb.store.kv"),
        session_secret: text_env("FZWEB_SESSION_SECRET", "fzweb-dev-secret"),
        timeout_ms: i32_env("FZWEB_TIMEOUT_MS", 2500, 1, 30000),
        max_body_bytes: i32_env("FZWEB_MAX_BODY_BYTES", 1048576, 64, 16777216),
        enable_cors: bool_env("FZWEB_ENABLE_CORS", 1),
        enable_request_log: bool_env("FZWEB_ENABLE_REQUEST_LOG", 1),
        require_auth: bool_env("FZWEB_REQUIRE_AUTH", 0),
        auth_token: text_env("FZWEB_AUTH_TOKEN", ""),
        require_json_body: bool_env("FZWEB_REQUIRE_JSON_BODY", 1),
        enable_rate_limit: bool_env("FZWEB_ENABLE_RATE_LIMIT", 1),
        rate_capacity: i32_env("FZWEB_RATE_CAPACITY", 120, 1, 100000),
        rate_refill_ms: i32_env("FZWEB_RATE_REFILL_MS", 1000, 1, 600000),
        max_requests: i32_env("FZWEB_MAX_REQUESTS", 2000000000, 1, 2000000000),
    }
}

fn policy_from_config(cfg: ServerConfig) -> middleware.Policy {
    return middleware.policy(
        cfg.timeout_ms,
        cfg.max_body_bytes,
        cfg.require_auth,
        cfg.auth_token,
        cfg.enable_cors,
        cfg.enable_request_log,
        cfg.require_json_body,
        cfg.enable_rate_limit,
        cfg.rate_capacity,
        cfg.rate_refill_ms,
    )
}

fn metrics_new() -> MetricsState {
    return MetricsState {
        total_requests: 0,
        ok_responses: 0,
        client_errors: 0,
        server_errors: 0,
        unauthorized: 0,
        rate_limited: 0,
    }
}

fn metrics_record(metrics: MetricsState, status: i32) -> MetricsState {
    let mut ok = metrics.ok_responses
    let mut client = metrics.client_errors
    let mut server = metrics.server_errors
    let mut unauthorized = metrics.unauthorized
    let mut rate_limited = metrics.rate_limited

    if status >= 200 && status < 300 {
        ok += 1
    }
    if status >= 400 && status < 500 {
        client += 1
    }
    if status >= 500 {
        server += 1
    }
    if status == 401 {
        unauthorized += 1
    }
    if status == 429 {
        rate_limited += 1
    }

    return MetricsState {
        total_requests: metrics.total_requests + 1,
        ok_responses: ok,
        client_errors: client,
        server_errors: server,
        unauthorized: unauthorized,
        rate_limited: rate_limited,
    }
}

fn gate_body(reason: str) -> str {
    return response.error_body(response.api_error(400, reason, reason, ""))
}

fn safe_static_name(name: str) -> str {
    if name == "" {
        return "index.txt"
    }
    if str.contains(name, "..") == 1 {
        return "blocked.txt"
    }
    if str.contains(name, "/") == 1 {
        return "blocked.txt"
    }
    return name
}

fn static_body(name: str) -> str {
    return str.concat("static asset: ", safe_static_name(name))
}

fn metrics_text(metrics: MetricsState, started_ms: i32) -> str {
    let uptime_ms = time.monotonic_ms() - started_ms
    let line1 = str.concat("fzweb_requests_total ", str.from_i32(metrics.total_requests))
    let line2 = str.concat("fzweb_responses_ok ", str.from_i32(metrics.ok_responses))
    let line3 = str.concat("fzweb_responses_client_error ", str.from_i32(metrics.client_errors))
    let line4 = str.concat("fzweb_responses_server_error ", str.from_i32(metrics.server_errors))
    let line5 = str.concat("fzweb_unauthorized_total ", str.from_i32(metrics.unauthorized))
    let line6 = str.concat("fzweb_rate_limited_total ", str.from_i32(metrics.rate_limited))
    let line7 = str.concat("fzweb_uptime_ms ", str.from_i32(uptime_ms))
    return str.concat(line1, "\n", line2, "\n", line3, "\n", line4, "\n", line5, "\n", line6, "\n", line7)
}

fn route_kernel_score(method: str, path: str) -> i32 {
    let mut score = (str.len(method) * 17) + (str.len(path) * 19)
    if method == "GET" {
        score += 11
    }
    if method == "POST" {
        score += 13
    }
    if path == "/healthz" {
        score += 23
    }
    if str.starts_with(path, "/static/") == 1 {
        score += 29
    }
    return score % 251
}

fn session_config(cfg: ServerConfig) -> sessions.SessionConfig {
    return sessions.config(cfg.store_path, cfg.session_secret, "fzweb_session", 3600)
}

fn default_app(cfg: ServerConfig) -> app.App {
    let mut web = app.make(cfg.service_name, cfg.service_version, cfg.store_path, cfg.session_secret)
    web = app.use_middleware(web, "security_headers")
    web = app.use_middleware(web, "request_log")
    web = app.use_middleware(web, "cors")
    web = app.use_middleware(web, "auth")
    web = app.use_middleware(web, "json")
    web = app.use_middleware(web, "rate_limit")

    web = app.add_route(web, app.route(app.route_root_id(), "root", "GET", "/", "/", 1, 1, 0))
    web = app.add_route(web, app.route(app.route_healthz_id(), "healthz", "GET", "/healthz", "/", 1, 1, 0))
    web = app.add_route(web, app.route(app.route_readyz_id(), "readyz", "GET", "/readyz", "/", 1, 1, 0))
    web = app.add_route(web, app.route(app.route_metrics_id(), "metrics", "GET", "/metrics", "/", 1, 1, 0))
    web = app.add_route(web, app.route(app.route_inspect_id(), "inspect", "GET", "/inspect", "/", 0, 0, 0))
    web = app.add_route(web, app.route(app.route_search_id(), "search", "GET", "/search", "/", 0, 0, 0))
    web = app.add_route(web, app.route(app.route_echo_post_id(), "echo_post", "POST", "/echo", "/", 0, 0, 1))
    web = app.add_route(web, app.route(app.route_echo_name_id(), "echo_name", "GET", "/v1/echo/:name", "/v1", 0, 0, 0))
    web = app.add_route(web, app.route(app.route_bind_id(), "bind", "POST", "/bind", "/", 0, 0, 1))
    web = app.add_route(web, app.route(app.route_openapi_id(), "openapi", "GET", "/openapi.json", "/", 1, 1, 0))
    web = app.add_route(web, app.route(app.route_version_id(), "version", "GET", "/version", "/", 1, 1, 0))
    web = app.add_route(web, app.route(app.route_static_id(), "static", "GET", "/static/:name", "/", 0, 0, 0))
    web = app.add_route(web, app.route(app.route_items_list_id(), "items_list", "GET", "/v1/items", "/v1", 0, 0, 0))
    web = app.add_route(web, app.route(app.route_item_get_id(), "item_get", "GET", "/v1/items/:id", "/v1", 0, 0, 0))
    web = app.add_route(web, app.route(app.route_item_put_id(), "item_put", "PUT", "/v1/items/:id", "/v1", 0, 0, 1))
    web = app.add_route(web, app.route(app.route_item_patch_id(), "item_patch", "PATCH", "/v1/items/:id", "/v1", 0, 0, 1))
    web = app.add_route(web, app.route(app.route_item_delete_id(), "item_delete", "DELETE", "/v1/items/:id", "/v1", 0, 0, 0))
    web = app.add_route(web, app.route(app.route_cookie_set_id(), "cookie_set", "GET", "/cookies/set", "/cookies", 1, 1, 0))
    web = app.add_route(web, app.route(app.route_session_login_id(), "session_login", "POST", "/session/login", "/session", 1, 1, 1))
    web = app.add_route(web, app.route(app.route_session_me_id(), "session_me", "GET", "/session/me", "/session", 1, 0, 0))
    web = app.add_route(web, app.route(app.route_upload_multipart_id(), "upload_multipart", "POST", "/upload", "/", 0, 0, 0))
    web = app.add_route(web, app.route(app.route_events_id(), "events", "GET", "/events", "/", 1, 1, 0))
    web = app.add_route(web, app.route(app.route_ws_echo_id(), "ws_echo", "GET", "/ws", "/", 1, 1, 0))
    return web
}

fn outcome(rate: middleware.RateState, metrics: MetricsState, status: i32) -> HandleOutcome {
    return HandleOutcome {
        status: status,
        rate: rate,
        metrics: metrics_record(metrics, status),
    }
}

fn emit_outcome(
    conn: HttpHandle,
    plan: response.ResponsePlan,
    rate: middleware.RateState,
    metrics: MetricsState,
) -> HandleOutcome {
    discard response.emit(conn, plan)
    return outcome(rate, metrics, plan.status)
}

fn request_error_plan(err: request.RequestError) -> response.ResponsePlan {
    return response.error_plan(response.request_error(err))
}

fn item_version(conn: HttpHandle) -> request.IntResult {
    return request.query_i32(conn, "version", 1, 1, 1000000)
}

fn handle_root(ctx: request.RequestContext, cfg: ServerConfig) -> response.ResponsePlan {
    return response.json_plan(200, response.service_json(cfg.service_name, cfg.service_version, ctx.request_id))
}

fn handle_healthz() -> response.ResponsePlan {
    return response.text(200, "ok")
}

fn handle_readyz() -> response.ResponsePlan {
    return response.text(200, "ready")
}

fn handle_metrics(metrics: MetricsState, started_ms: i32) -> response.ResponsePlan {
    return response.bytes(200, "text/plain; version=0.0.4; charset=utf-8", metrics_text(metrics, started_ms))
}

fn handle_inspect(conn: HttpHandle, ctx: request.RequestContext) -> response.ResponsePlan {
    return response.json_plan(
        200,
        response.inspect_json(
            ctx.request_id,
            request.method(conn),
            request.path(conn),
            request.remote(conn),
            request.accept(conn),
            request.content_type(conn),
            ctx.route_name,
        ),
    )
}

fn handle_search(conn: HttpHandle, ctx: request.RequestContext) -> response.ResponsePlan {
    let limit = request.query_i32(conn, "limit", 10, 1, 1000)
    if limit.ok == 0 {
        return request_error_plan(limit.err)
    }
    return response.json_plan(
        200,
        response.search_json(request.query(conn, "q"), limit.value, ctx.request_id),
    )
}

fn handle_echo_post(conn: HttpHandle, ctx: request.RequestContext) -> response.ResponsePlan {
    let mut body = request.body_max(conn, 1048576)
    if body == "" && request.body_eof(conn) == 0 {
        while request.body_eof(conn) == 0 && str.len(body) < 1048576 {
            body = str.concat(body, request.body_read(conn, 512))
        }
    }
    if body == "" && request.content_type_is_json(conn) == 1 {
        body = json.get_str(request.body_json(conn), "raw")
    }
    if body == "" {
        return response.json_plan(200, response.ok_json("echo", ctx.request_id))
    }
    return response.json_plan(200, body)
}

fn handle_echo_name(conn: HttpHandle, ctx: request.RequestContext) -> response.ResponsePlan {
    let name = request.param_required(conn, "name")
    if name.ok == 0 {
        return request_error_plan(name.err)
    }
    return response.json_plan(200, response.named_echo_json(name.value, ctx.request_id))
}

fn handle_bind(conn: HttpHandle, ctx: request.RequestContext) -> response.ResponsePlan {
    let payload = request.body_json_required(conn, ctx.route_name)
    if payload.ok == 0 {
        return request_error_plan(payload.err)
    }
    let user = request.json_required_str(payload.payload, "user")
    if user.ok == 0 {
        return request_error_plan(user.err)
    }
    return response.json_plan(
        200,
        response.bind_json(user.value, request.json_bool_default(payload.payload, "active", 0), ctx.request_id),
    )
}

fn handle_openapi(web: app.App) -> response.ResponsePlan {
    return response.json_plan(200, app.openapi_json(web))
}

fn handle_version(ctx: request.RequestContext, cfg: ServerConfig) -> response.ResponsePlan {
    return response.json_plan(200, response.version_json(cfg.service_name, cfg.service_version, ctx.request_id))
}

fn handle_static(conn: HttpHandle, ctx: request.RequestContext) -> response.ResponsePlan {
    let name = request.param_required(conn, "name")
    if name.ok == 0 {
        return request_error_plan(name.err)
    }
    return response.bytes(200, "text/plain; charset=utf-8", static_body(name.value))
}

fn handle_items_list(ctx: request.RequestContext) -> response.ResponsePlan {
    return response.json_plan(200, response.items_json(ctx.request_id))
}

fn handle_item_get(conn: HttpHandle, ctx: request.RequestContext) -> response.ResponsePlan {
    let item_id = request.param_required(conn, "id")
    if item_id.ok == 0 {
        return request_error_plan(item_id.err)
    }
    let version = item_version(conn)
    if version.ok == 0 {
        return request_error_plan(version.err)
    }
    return response.json_plan(200, response.item_view_json(item_id.value, version.value, 1, ctx.request_id))
}

fn handle_item_put(conn: HttpHandle, ctx: request.RequestContext, cfg: ServerConfig) -> response.ResponsePlan {
    let item_id = request.param_required(conn, "id")
    if item_id.ok == 0 {
        return request_error_plan(item_id.err)
    }
    let version = item_version(conn)
    if version.ok == 0 {
        return request_error_plan(version.err)
    }
    let payload = request.body_json_required(conn, ctx.route_name)
    if payload.ok == 0 {
        return request_error_plan(payload.err)
    }
    discard persistence.put_json(
        persistence.open(cfg.store_path),
        "item",
        item_id.value,
        payload.raw,
    )
    return response.json_plan(200, response.item_json("updated", item_id.value, version.value, ctx.request_id))
}

fn handle_item_patch(conn: HttpHandle, ctx: request.RequestContext, cfg: ServerConfig) -> response.ResponsePlan {
    let item_id = request.param_required(conn, "id")
    if item_id.ok == 0 {
        return request_error_plan(item_id.err)
    }
    let version = item_version(conn)
    if version.ok == 0 {
        return request_error_plan(version.err)
    }
    let payload = request.body_json_required(conn, ctx.route_name)
    if payload.ok == 0 {
        return request_error_plan(payload.err)
    }
    discard persistence.put_json(
        persistence.open(cfg.store_path),
        "item_patch",
        item_id.value,
        payload.raw,
    )
    return response.json_plan(200, response.item_json("patched", item_id.value, version.value, ctx.request_id))
}

fn handle_item_delete(conn: HttpHandle, ctx: request.RequestContext) -> response.ResponsePlan {
    let item_id = request.param_required(conn, "id")
    if item_id.ok == 0 {
        return request_error_plan(item_id.err)
    }
    let version = item_version(conn)
    if version.ok == 0 {
        return request_error_plan(version.err)
    }
    return response.accepted_json(response.item_json("deleted", item_id.value, version.value, ctx.request_id))
}

fn handle_cookie_set(conn: HttpHandle, ctx: request.RequestContext) -> response.ResponsePlan {
    discard cookies.set_cookie(conn, "theme", "light", "/", 86400, 0, 1, "Lax")
    return response.json_plan(200, response.ok_json("cookie_set", ctx.request_id))
}

fn handle_session_login(conn: HttpHandle, ctx: request.RequestContext, cfg: ServerConfig) -> response.ResponsePlan {
    let payload = request.body_json_required(conn, ctx.route_name)
    if payload.ok == 0 {
        return request_error_plan(payload.err)
    }
    let mut user = json.get_str(payload.payload, "user")
    if user == "" {
        user = request.query(conn, "user")
    }
    if str.trim(user) == "" {
        return response.error_plan(response.api_error(400, "missing_user", "session user is required", "user"))
    }
    let rec = sessions.create(session_config(cfg), user)
    discard sessions.attach(conn, session_config(cfg), rec)
    return response.json_plan(200, response.bind_json(rec.user, 1, ctx.request_id))
}

fn handle_session_me(conn: HttpHandle, ctx: request.RequestContext, cfg: ServerConfig) -> response.ResponsePlan {
    let rec = sessions.from_request(conn, session_config(cfg))
    if sessions.valid(rec) == 0 {
        return response.error_plan(response.api_error(401, "unauthorized", "unauthorized", ctx.route_name))
    }
    return response.json_plan(200, response.bind_json(rec.user, 1, ctx.request_id))
}

fn handle_route(
    conn: HttpHandle,
    web: app.App,
    decision: app.RouteDecision,
    cfg: ServerConfig,
    metrics: MetricsState,
    rate: middleware.RateState,
    started_ms: i32,
) -> HandleOutcome {
    if decision.method_allowed == 0 {
        discard webcore.response_method_not_allowed(conn)
        return outcome(rate, metrics, 405)
    }

    if app.has_middleware(web, "security_headers") == 1 {
        discard cookies.default_security_headers(conn)
    }

    let ctx = request.context(decision.route_id, decision.route_name, decision.route_path, request.request_id(conn))

    if decision.route_id == app.route_root_id() {
        return emit_outcome(conn, handle_root(ctx, cfg), rate, metrics)
    }
    if decision.route_id == app.route_healthz_id() {
        return emit_outcome(conn, handle_healthz(), rate, metrics)
    }
    if decision.route_id == app.route_readyz_id() {
        return emit_outcome(conn, handle_readyz(), rate, metrics)
    }
    if decision.route_id == app.route_metrics_id() {
        return emit_outcome(conn, handle_metrics(metrics, started_ms), rate, metrics)
    }
    if decision.route_id == app.route_inspect_id() {
        return emit_outcome(conn, handle_inspect(conn, ctx), rate, metrics)
    }
    if decision.route_id == app.route_search_id() {
        return emit_outcome(conn, handle_search(conn, ctx), rate, metrics)
    }
    if decision.route_id == app.route_echo_post_id() {
        return emit_outcome(conn, handle_echo_post(conn, ctx), rate, metrics)
    }
    if decision.route_id == app.route_echo_name_id() {
        return emit_outcome(conn, handle_echo_name(conn, ctx), rate, metrics)
    }
    if decision.route_id == app.route_bind_id() {
        return emit_outcome(conn, handle_bind(conn, ctx), rate, metrics)
    }
    if decision.route_id == app.route_openapi_id() {
        return emit_outcome(conn, handle_openapi(web), rate, metrics)
    }
    if decision.route_id == app.route_version_id() {
        return emit_outcome(conn, handle_version(ctx, cfg), rate, metrics)
    }
    if decision.route_id == app.route_static_id() {
        return emit_outcome(conn, handle_static(conn, ctx), rate, metrics)
    }
    if decision.route_id == app.route_items_list_id() {
        return emit_outcome(conn, handle_items_list(ctx), rate, metrics)
    }
    if decision.route_id == app.route_item_get_id() {
        return emit_outcome(conn, handle_item_get(conn, ctx), rate, metrics)
    }
    if decision.route_id == app.route_item_put_id() {
        return emit_outcome(conn, handle_item_put(conn, ctx, cfg), rate, metrics)
    }
    if decision.route_id == app.route_item_patch_id() {
        return emit_outcome(conn, handle_item_patch(conn, ctx, cfg), rate, metrics)
    }
    if decision.route_id == app.route_item_delete_id() {
        return emit_outcome(conn, handle_item_delete(conn, ctx), rate, metrics)
    }
    if decision.route_id == app.route_cookie_set_id() {
        return emit_outcome(conn, handle_cookie_set(conn, ctx), rate, metrics)
    }
    if decision.route_id == app.route_session_login_id() {
        return emit_outcome(conn, handle_session_login(conn, ctx, cfg), rate, metrics)
    }
    if decision.route_id == app.route_session_me_id() {
        return emit_outcome(conn, handle_session_me(conn, ctx, cfg), rate, metrics)
    }
    if decision.route_id == app.route_upload_multipart_id() {
        let upload = multipart.parse(conn, cfg.max_body_bytes)
        return emit_outcome(conn, response.json_plan(200, multipart.json_summary(upload, ctx.request_id)), rate, metrics)
    }
    if decision.route_id == app.route_events_id() {
        discard streaming.send_sse_boot(conn)
        return outcome(rate, metrics, 200)
    }
    if decision.route_id == app.route_ws_echo_id() {
        discard streaming.websocket_echo(conn)
        return outcome(rate, metrics, 200)
    }

    discard webcore.response_not_found(conn)
    return outcome(rate, metrics, 404)
}

fn run_live_server() -> i32 {
    discard log.set_json(1)
    let cfg = server_config()
    let web = default_app(cfg)
    let policy = policy_from_config(cfg)
    let listener = http.bind()
    if http.listen(listener) != 0 {
        close(listener)
        return 11
    }

    discard log.info("fzweb.server.start", fields2("component", "fzweb", "mode", "live"))

    let started_ms = time.monotonic_ms()
    let mut handled = 0
    let mut rate = middleware.rate_init(policy, started_ms)
    let mut metrics = metrics_new()

    while handled < cfg.max_requests {
        let conn = http.accept()
        let read_status = webcore.request_read(conn)
        if read_status != 0 {
            discard webcore.response_service_unavailable(conn, "{\"error\":\"read_failed\"}")
            metrics = metrics_record(metrics, 503)
            handled += 1
            continue
        }

        let decision = app.select(web, conn)
        let gate = middleware.before_dispatch(conn, web, decision, policy, rate)
        rate = gate.rate
        if gate.handled == 1 {
            if gate.status == 204 {
                discard response.no_content(conn)
            } else {
                discard response.send_json(conn, gate.status, gate_body(gate.reason))
            }
            metrics = metrics_record(metrics, gate.status)
            handled += 1
            if (handled % 256) == 0 {
                yield()
            }
            continue
        }

        let result = handle_route(conn, web, decision, cfg, metrics, rate, started_ms)
        metrics = result.metrics
        rate = result.rate
        handled += 1
        if (handled % 256) == 0 {
            yield()
        }
    }

    close(listener)
    return 0
}
