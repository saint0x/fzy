use core.simd;

fn alpha_mask(block: [u32; 4]) -> mask32x4 {
    let value = simd.u32x4_load(block)
    let lower = simd.mask32x4_and(
        simd.u32x4_ge(value, simd.u32x4_new(97, 97, 97, 97)),
        simd.u32x4_le(value, simd.u32x4_new(122, 122, 122, 122)),
    )
    let upper = simd.mask32x4_and(
        simd.u32x4_ge(value, simd.u32x4_new(65, 65, 65, 65)),
        simd.u32x4_le(value, simd.u32x4_new(90, 90, 90, 90)),
    )
    return simd.mask32x4_or(lower, upper)
}

fn delimiter_bitmask(block: [u32; 4]) -> i32 {
    let value = simd.u32x4_load(block)
    let is_space = simd.u32x4_eq(value, simd.u32x4_new(32, 32, 32, 32))
    let is_comma = simd.u32x4_eq(value, simd.u32x4_new(44, 44, 44, 44))
    let is_colon = simd.u32x4_eq(value, simd.u32x4_new(58, 58, 58, 58))
    let is_tab = simd.u32x4_eq(value, simd.u32x4_new(9, 9, 9, 9))
    let delimiter_mask = simd.mask32x4_or(
        simd.mask32x4_or(is_space, is_comma),
        simd.mask32x4_or(is_colon, is_tab),
    )
    return simd.mask32x4_bitmask(delimiter_mask)
}

fn equality_bitmask(left: [u32; 4], right: [u32; 4]) -> i32 {
    return simd.mask32x4_bitmask(simd.u32x4_eq(simd.u32x4_load(left), simd.u32x4_load(right)))
}

fn validate_ascii_scan() -> i32 {
    let block = simd.u32x4_store(simd.u32x4_new(65, 122, 44, 57))
    let alpha = alpha_mask(block)
    if simd.mask32x4_all(alpha) == true {
        return 11
    }
    if simd.mask32x4_bitmask(alpha) != 3 {
        return 13
    }
    if delimiter_bitmask(block) != 4 {
        return 15
    }
    return 0
}

fn validate_token_scan() -> i32 {
    let left = simd.u32x4_store(simd.u32x4_new(58, 44, 120, 32))
    let right = simd.u32x4_store(simd.u32x4_new(58, 10, 120, 95))
    let bitmask = equality_bitmask(left, right)
    if bitmask != 5 {
        return 21
    }
    let delimiters = delimiter_bitmask(left)
    if delimiters != 11 {
        return 23
    }
    let merged = simd.u32x4_max(simd.u32x4_load(left), simd.u32x4_load(right))
    if simd.u32x4_reduce_max(merged) != simd.u32x4_lane2(merged) {
        return 25
    }
    if simd.u32x4_reduce_min(merged) != simd.u32x4_lane1(merged) {
        return 27
    }
    return 0
}

fn main() -> i32 {
    let ascii = validate_ascii_scan()
    if ascii != 0 {
        return ascii
    }
    let token = validate_token_scan()
    if token != 0 {
        return token
    }
    return 0
}
